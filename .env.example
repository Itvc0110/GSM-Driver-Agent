# Mẫu cấu hình môi trường — copy thành .env và điền giá trị thật (KHÔNG commit .env)
AI_PROVIDER=openai
OPENAI_BASE_URL=https://api.ai-box.vn/v1
OPENAI_API_KEY=sk-xxx
DEFAULT_MODEL=deepseek-v4-flash
FALLBACK_MODEL=gpt-4o-mini
# Optional
# MAPBOX_TOKEN=            # basemap đẹp cho kepler.gl (có fallback Carto/OSM)
# LANGFUSE_PUBLIC_KEY=     # observability (T-020) — điền khi bật Langfuse
# LANGFUSE_SECRET_KEY=
# LANGFUSE_HOST=
