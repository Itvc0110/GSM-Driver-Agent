# Mẫu cấu hình — copy thành .env và điền giá trị thật (KHÔNG commit .env)

AI_PROVIDER=openrouter
# LLM chính: OpenRouter (deepseek-v4-flash = rẻ nhất)
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
DEFAULT_MODEL=deepseek/deepseek-v4-flash
# AdviceCheckpoint safety defaults — keep provider and product polling off locally.
ADVICE_V2_ENABLED=0
ADVICE_PRESENTATION_MODE=template
ADVICE_WHY_AGENT_ENABLED=0
ADVICE_AGENT_ALLOWLIST=0
ADVICE_AGENT_KILL_SWITCH=0
ADVICE_AGENT_TIMEOUT_S=8
ADVICE_AGENT_MAX_CALLS=20
ADVICE_AGENT_MAX_OUTPUT_TOKENS=256
# Fallback: OpenAI trực tiếp
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
FALLBACK_MODEL=gpt-4o-mini

# External data (mỗi dịch vụ có free tier riêng — BẮT BUỘC cache local)
WEATHER_API_KEY=            # weatherapi.com — forecast + alerts
WEATHER_BASE_URL=https://api.weatherapi.com/v1
JINA_API_KEY=               # r.jina.ai reader — crawl policy/sự kiện
JINA_READER_URL=https://r.jina.ai
STADIA_MAPS_API_KEY=        # tiles + geocoding cho UI
STADIA_BASE_URL=https://api.stadiamaps.com
# Routing driver-app (ui/backend/app/routers/routing.py), 3 tier theo thứ tự thử — UPDATE-119:
#   1. OSRM public demo (OSRM_BASE_URL)      — thật, KHÔNG cần key, KHÔNG giới hạn cố định (nhưng
#      là server cộng đồng "giới hạn lịch sự" không công bố, có thể chết bất cứ lúc nào)
#   2. GraphHopper (GRAPHHOPPER_API_KEY)     — thật, CẦN key, free tier 500 credit/ngày
#   3. Ước lượng đường thẳng (không cần biến nào) — luôn chạy được, KHÔNG phải đường thật, chỉ
#      dùng khi cả (1) và (2) đều lỗi
OSRM_BASE_URL=https://router.project-osrm.org   # KHÔNG cần key
GRAPHHOPPER_API_KEY=         # graphhopper.com Directions API, tier 2 — ⚠ ĐỔI TÊN từ biến cũ
                             # `apikey_graphhopper` (chữ thường, không convention) nếu .env của bạn
                             # còn dùng tên đó — code chỉ đọc đúng SCREAMING_SNAKE_CASE này
GOOGLE_MAPS_API_KEY=        # (tuỳ chọn) key phải bắt đầu 'AIza…'

# Observability
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://us.cloud.langfuse.com

# Hạ tầng: LOCAL hết (chưa dùng BigQuery — xem DEFERRED D-GCP-01)
GSM_DATA_SOURCE=mock
GSM_LOCAL_DATA_DIR=data/mock/realdata-v1
