# Mẫu cấu hình — copy thành .env và điền giá trị thật (KHÔNG commit .env)

AI_PROVIDER=openrouter
# LLM chính: OpenRouter (deepseek-v4-flash = rẻ nhất)
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
DEFAULT_MODEL=deepseek/deepseek-v4-flash
# AdviceCheckpoint safety defaults — keep provider and product polling off locally.
ADVICE_V2_ENABLED=0
ADVICE_PRESENTATION_MODE=template
ADVICE_WHY_AGENT_ENABLED=0
ADVICE_AGENT_ALLOWLIST=0
ADVICE_AGENT_KILL_SWITCH=0
ADVICE_AGENT_TIMEOUT_S=8
ADVICE_AGENT_MAX_CALLS=20
ADVICE_AGENT_MAX_OUTPUT_TOKENS=256
# Fallback: OpenAI trực tiếp
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
FALLBACK_MODEL=gpt-4o-mini

# External data (mỗi dịch vụ có free tier riêng — BẮT BUỘC cache local)
WEATHER_API_KEY=            # weatherapi.com — forecast + alerts
WEATHER_BASE_URL=https://api.weatherapi.com/v1
JINA_API_KEY=               # r.jina.ai reader — crawl policy/sự kiện
JINA_READER_URL=https://r.jina.ai
STADIA_MAPS_API_KEY=        # tiles + geocoding cho UI
STADIA_BASE_URL=https://api.stadiamaps.com
# Routing driver-app (ui/backend/app/routers/routing.py), 3 tier theo thứ tự thử — UPDATE-120,
# sửa đường nối ở UPDATE-128:
#   1. OSRM public — HAI mirror, thật, KHÔNG cần key. Mirror A viết cứng
#      (routing.openstreetmap.de/routed-car, đường dẫn riêng nên không cấu hình được); mirror B
#      đọc `OSRM_BASE_URL`. Đều là server cộng đồng "giới hạn lịch sự" không công bố.
#   2. GraphHopper (GRAPHHOPPER_API_KEY)     — thật, CẦN key, free tier 500 credit/ngày
#   3. Ước lượng đường thẳng (không cần biến nào) — luôn chạy được, KHÔNG phải đường thật, chỉ
#      dùng khi cả (1) và (2) đều lỗi (trả `route_is_real_road: false`)
#
# ⚠ ĐỪNG đổi mirror để chữa rate limit: `router.project-osrm.org` và `routing.openstreetmap.de`
# CÙNG phân giải về một máy — 5.148.170.168 và cùng cả IPv6 2a02:418:39aa:8::7 (hạ tầng FOSSGIS)
# ⇒ cùng một hạn mức. Đường đúng là để tier 2 (GraphHopper) hoạt động, hoặc cache.
# Kiểm bằng gọi thật + phân giải DNS 2026-08-03.
#
# ⚠ Chú thích trong file này viết CÙNG DÒNG với biến. Bộ nạp (`gsm_core.advisor.llm_client
# .load_env`) CẮT chú thích inline từ 2026-08-03 — trước đó nó không cắt, nên copy file này thành
# `.env` cho ra giá trị RÁC mà mọi guard `if not x` đều cho đi qua (một khoá = chuỗi chú thích là
# truthy ⇒ gọi API thật rồi 401). Cổng: `tests/test_env_loader_inline_comment.py`.
OSRM_BASE_URL=https://router.project-osrm.org   # KHÔNG cần key. Có cổng: ui/backend/tests/
                                                # test_osrm_endpoints_wired.py (biến này PHẢI
                                                # được đọc; trước UPDATE-128 nó bị viết cứng)
GRAPHHOPPER_API_KEY=         # graphhopper.com Directions API, tier 2 — ⚠ ĐỔI TÊN từ biến cũ
                             # `apikey_graphhopper` (chữ thường, không convention) nếu .env của bạn
                             # còn dùng tên đó — code chỉ đọc đúng SCREAMING_SNAKE_CASE này.
                             # ⚠ THIẾU biến này thì try_graphhopper() return None LẶNG LẼ ⇒ tier 2
                             # không tồn tại và app tụt thẳng xuống tier 3 (không phải đường thật).
                             # `.env` bị gitignore nên biến này KHÔNG tự sang máy đồng đội — mỗi
                             # người phải tự nạp. Đã trả giá đúng một lần (UPDATE-128).
GOOGLE_MAPS_API_KEY=        # (tuỳ chọn) key phải bắt đầu 'AIza…'.
                            # ⚠ 2026-08-03: KHÔNG code nào trong repo đọc biến này, và key đang
                            # có trong .env của Cường trả REQUEST_DENIED ("API key is invalid").
                            # Đừng dựa vào nó — repo hiện KHÔNG có Google Maps hoạt động.

# Observability
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://us.cloud.langfuse.com

# Hạ tầng: LOCAL hết (chưa dùng BigQuery — xem DEFERRED D-GCP-01)
GSM_DATA_SOURCE=mock
GSM_LOCAL_DATA_DIR=data/mock/realdata-v1
