{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://driver-income-os.local/contracts/optimization_request.schema.json",
  "title": "OptimizationRequest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "request_id",
    "snapshot_id",
    "requested_at",
    "data_mode",
    "horizon_minutes",
    "scenario_count",
    "solver_time_limit_ms",
    "allowed_actions",
    "constraint_overlay",
    "model_bundle_version",
    "policy_bundle_version",
    "trace_id"
  ],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "request_id": { "type": "string", "minLength": 1 },
    "snapshot_id": { "type": "string", "minLength": 1 },
    "requested_at": { "type": "string", "format": "date-time" },
    "data_mode": { "enum": ["synthetic", "replay", "shadow", "live"] },
    "horizon_minutes": { "type": "integer", "minimum": 15, "maximum": 1440 },
    "bucket_minutes": { "type": "integer", "minimum": 1, "maximum": 60, "default": 15 },
    "scenario_count": { "type": "integer", "minimum": 1, "maximum": 1000 },
    "random_seed": { "type": ["integer", "null"] },
    "solver_time_limit_ms": { "type": "integer", "minimum": 10, "maximum": 120000 },
    "allowed_actions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/actionType" }
    },
    "constraint_overlay": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "risk_mode": { "enum": ["STABLE", "BALANCED", "STRETCH"] },
        "target_net_minor": { "type": ["integer", "null"], "minimum": 0 },
        "hard_end_time": { "type": ["string", "null"], "format": "date-time" },
        "end_zone_id": { "type": ["string", "null"] },
        "max_extra_minutes": { "type": ["integer", "null"], "minimum": 0 },
        "max_extra_distance_m": { "type": ["integer", "null"], "minimum": 0 },
        "pursue_bonus_program_id": { "type": ["string", "null"] }
      }
    },
    "model_bundle_version": { "type": "string", "minLength": 1 },
    "policy_bundle_version": { "type": "string", "minLength": 1 },
    "idempotency_key": { "type": ["string", "null"] },
    "trace_id": { "type": "string", "minLength": 1 }
  },
  "$defs": {
    "actionType": {
      "enum": [
        "START_SHIFT_AT",
        "END_SHIFT",
        "CONTINUE_CURRENT_PLAN",
        "CHARGE_NOW",
        "CHARGE_LATER",
        "TAKE_BREAK_NOW",
        "TAKE_BREAK_LATER",
        "ACTIVATE_HOMEWARD",
        "RETURN_TO_DEPOT",
        "PURSUE_BONUS_TIER",
        "STOP_PURSUING_BONUS",
        "ADJUST_DAILY_TARGET",
        "REVIEW_SHIFT_INSIGHT",
        "NO_RECOMMENDATION",
        "STAY_IN_ZONE",
        "REPOSITION_TO_ZONE"
      ]
    }
  }
}
