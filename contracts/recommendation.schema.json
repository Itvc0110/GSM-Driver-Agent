{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://driver-income-os.local/contracts/recommendation.schema.json",
  "title": "RecommendationEnvelope",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "recommendation_id",
    "driver_pseudonym",
    "snapshot_id",
    "trace_id",
    "generated_at",
    "valid_from",
    "expires_at",
    "status",
    "data_mode",
    "is_mock",
    "currency",
    "versions",
    "solver",
    "baseline",
    "options",
    "recommended_option_id",
    "policy_decision",
    "data_quality",
    "caveats"
  ],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "recommendation_id": { "type": "string", "minLength": 1 },
    "driver_pseudonym": { "type": "string", "minLength": 1 },
    "snapshot_id": { "type": "string", "minLength": 1 },
    "trace_id": { "type": "string", "minLength": 1 },
    "generated_at": { "type": "string", "format": "date-time" },
    "valid_from": { "type": "string", "format": "date-time" },
    "expires_at": { "type": "string", "format": "date-time" },
    "status": { "enum": ["ACTIVE", "SUPERSEDED", "EXPIRED", "ACCEPTED", "IGNORED", "NO_RECOMMENDATION"] },
    "data_mode": { "enum": ["synthetic", "replay", "shadow", "live"] },
    "is_mock": { "type": "boolean" },
    "currency": { "type": "string", "pattern": "^[A-Z]{3}$" },
    "versions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model_bundle", "policy_bundle", "optimizer", "net_definition"],
      "properties": {
        "model_bundle": { "type": "string" },
        "policy_bundle": { "type": "string" },
        "optimizer": { "type": "string" },
        "net_definition": { "type": "string" },
        "prompt_or_template": { "type": ["string", "null"] }
      }
    },
    "solver": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "wall_time_ms"],
      "properties": {
        "status": { "enum": ["OPTIMAL", "FEASIBLE", "INFEASIBLE", "MODEL_INVALID", "UNKNOWN", "HEURISTIC"] },
        "wall_time_ms": { "type": "integer", "minimum": 0 },
        "objective_value": { "type": ["number", "null"] },
        "best_bound": { "type": ["number", "null"] },
        "relative_gap": { "type": ["number", "null"], "minimum": 0 }
      }
    },
    "baseline": { "$ref": "#/$defs/outcomeEstimate" },
    "options": {
      "type": "array",
      "maxItems": 3,
      "items": { "$ref": "#/$defs/option" }
    },
    "recommended_option_id": { "type": ["string", "null"] },
    "policy_decision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["allowed", "reason_codes", "platform_guard_passed", "safety_guard_passed"],
      "properties": {
        "allowed": { "type": "boolean" },
        "reason_codes": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "platform_guard_passed": { "type": "boolean" },
        "safety_guard_passed": { "type": "boolean" },
        "capacity_token_id": { "type": ["string", "null"] }
      }
    },
    "data_quality": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "fresh_until", "confidence_level"],
      "properties": {
        "status": { "enum": ["OK", "DEGRADED", "STALE", "BLOCKED"] },
        "fresh_until": { "type": "string", "format": "date-time" },
        "confidence_level": { "enum": ["LOW", "MEDIUM", "HIGH", "UNKNOWN"] },
        "calibration_segment": { "type": ["string", "null"] }
      }
    },
    "caveats": { "type": "array", "items": { "type": "string" } }
  },
  "$defs": {
    "quantileMoney": {
      "type": "object",
      "additionalProperties": false,
      "required": ["p10_minor", "p50_minor", "p90_minor"],
      "properties": {
        "p10_minor": { "type": "integer" },
        "p50_minor": { "type": "integer" },
        "p90_minor": { "type": "integer" }
      }
    },
    "quantileNumber": {
      "type": "object",
      "additionalProperties": false,
      "required": ["p10", "p50", "p90", "unit"],
      "properties": {
        "p10": { "type": "number" },
        "p50": { "type": "number" },
        "p90": { "type": "number" },
        "unit": { "type": "string" }
      }
    },
    "outcomeEstimate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["expected_net", "net_per_hour", "total_minutes", "empty_distance_m", "goal_probability"],
      "properties": {
        "expected_net": { "$ref": "#/$defs/quantileMoney" },
        "net_per_hour": { "$ref": "#/$defs/quantileMoney" },
        "total_minutes": { "$ref": "#/$defs/quantileNumber" },
        "empty_distance_m": { "$ref": "#/$defs/quantileNumber" },
        "goal_probability": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
        "end_zone_id": { "type": ["string", "null"] },
        "end_time_p50": { "type": ["string", "null"], "format": "date-time" },
        "end_soc_percent_p50": { "type": ["number", "null"], "minimum": 0, "maximum": 100 }
      }
    },
    "option": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "option_id",
        "action_type",
        "action_window_start",
        "action_window_end",
        "outcome",
        "delta_vs_baseline_net",
        "downside_risk",
        "hard_constraints_passed",
        "tradeoff_codes",
        "reason_codes"
      ],
      "properties": {
        "option_id": { "type": "string", "minLength": 1 },
        "action_type": { "$ref": "#/$defs/actionType" },
        "action_window_start": { "type": "string", "format": "date-time" },
        "action_window_end": { "type": "string", "format": "date-time" },
        "target_zone_id": { "type": ["string", "null"] },
        "bonus_program_id": { "type": ["string", "null"] },
        "outcome": { "$ref": "#/$defs/outcomeEstimate" },
        "delta_vs_baseline_net": { "$ref": "#/$defs/quantileMoney" },
        "downside_risk": {
          "type": "object",
          "additionalProperties": false,
          "required": ["cvar_minor", "level"],
          "properties": {
            "cvar_minor": { "type": "integer" },
            "level": { "type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 1 }
          }
        },
        "hard_constraints_passed": { "type": "boolean" },
        "tradeoff_codes": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "reason_codes": { "type": "array", "items": { "type": "string" }, "uniqueItems": true }
      }
    },
    "actionType": {
      "enum": [
        "START_SHIFT_AT",
        "END_SHIFT",
        "CONTINUE_CURRENT_PLAN",
        "CHARGE_NOW",
        "CHARGE_LATER",
        "TAKE_BREAK_NOW",
        "TAKE_BREAK_LATER",
        "ACTIVATE_HOMEWARD",
        "RETURN_TO_DEPOT",
        "PURSUE_BONUS_TIER",
        "STOP_PURSUING_BONUS",
        "ADJUST_DAILY_TARGET",
        "REVIEW_SHIFT_INSIGHT",
        "NO_RECOMMENDATION",
        "STAY_IN_ZONE",
        "REPOSITION_TO_ZONE"
      ]
    }
  }
}
