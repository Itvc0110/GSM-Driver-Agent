"""Cycle W — 8 finding từ review đối kháng (lăng kính ngữ nghĩa). TDD đỏ trước.

Viết ở scratchpad để không nhiễu agent review đang chạy; move vào `tests/` sau.
"""

from __future__ import annotations

import pytest

from gsm_core.lifecycle import projections as P
from gsm_sim.config import Config
from gsm_sim.runner import derive_run_id, run_once


def _cfg_all() -> Config:
    c = Config.load("configs/pilot_dongda.yaml")
    c.data["advice"].update(enabled=True, coverage="all", single_actor_id=None,
                            channels={"shift_plan": True, "accept_lift": True,
                                      "shift_extend": True, "rest_window": True},
                            positioning_overrides="wait_only")
    return c


@pytest.fixture(scope="module")
def run_b():
    return run_once(_cfg_all(), seed=1000)


# ---------- F-1: adherence_view phải khớp GROUND TRUTH của sim ----------

def test_adherence_matches_sim_ground_truth(run_b):
    """Số adherence của projection phải khớp sự thật sim, sai số nhỏ.

    Đo được trước khi sửa: projection báo shift_plan 2,0% / accept_lift 0,0% /
    positioning 100% trong khi sự thật 52,2% / 53,6% / 48,8%. Nguyên nhân: map theo
    KIND, trong khi `followed` của sim nằm ở `detail["followed"]`; `advice_followed`
    chỉ log khi advice ĐỔI hành động (BRIDGE-3), `shift_extend`/`rest_window` chỉ log
    khi ĐÃ theo, positioning không có event `decided` per-actor."""
    ev = run_b.events
    rid = derive_run_id(_cfg_all(), 1000)
    view = P.adherence_view(P.sim_events_to_lifecycle(ev, run_id=rid))
    agg: dict[str, dict] = {}
    for (_run, _drv, topic), v in view.items():
        a = agg.setdefault(topic, {"decided": 0, "followed": 0})
        a["decided"] += v["decided"]
        a["followed"] += v["followed"]

    # ground truth từ chính sim
    gt_given = sum(1 for e in ev if e.kind == "advice_given")
    gt_follow = sum(1 for e in ev if e.kind == "advice_given" and e.detail.get("followed"))
    assert agg["shift_plan"]["decided"] == gt_given
    assert agg["shift_plan"]["followed"] == gt_follow

    gt_gate = sum(1 for e in ev if e.kind == "advice_bonus_gate")
    gt_gate_f = sum(1 for e in ev if e.kind == "advice_bonus_gate" and e.detail.get("followed"))
    assert agg["accept_lift"]["decided"] == gt_gate
    assert agg["accept_lift"]["followed"] == gt_gate_f

    # shift_extend chỉ được log KHI đã hoãn ⇒ 100% followed
    gt_ext = sum(1 for e in ev if e.kind == "advice_shift_extend")
    assert agg["shift_extend"] == {"decided": gt_ext, "followed": gt_ext}

    # positioning: mẫu số = số người ĐƯỢC GÁN (planner), không phải số người đã theo
    assigned = sum(e.detail.get("n_assigned", 0) for e in ev if e.kind == "standby_planner")
    followed = sum(1 for e in ev if e.kind == "standby_followed")
    assert agg["positioning"]["decided"] == assigned, "mẫu số phải gồm cả người KHÔNG theo"
    assert agg["positioning"]["followed"] == followed


# ---------- F-2: adherence_view không được trộn hai run ----------

def test_adherence_key_separates_runs():
    """actor 0 của run A và actor 0 của run B là hai người khác nhau."""
    a = [dict(_ev(), event_id="a1", decision_id="dA", run_id="runA", driver_id="0",
              payload={"topic": "shift_plan"})]
    b = [dict(_ev(), event_id="b1", decision_id="dB", run_id="runB", driver_id="0",
              payload={"topic": "shift_plan"})]
    view = P.adherence_view(a + b)
    assert len(view) == 2, f"phải tách theo run_id, đang gộp: {view}"


def _ev() -> dict:
    return {"event_id": "e", "decision_id": "d", "display_id": None, "driver_id": "0",
            "run_id": None, "event_type": "decided", "reason_code": None,
            "occurred_at": "2026-07-29T08:00:00+07:00",
            "observed_at": "2026-07-29T08:00:00+07:00", "actor": "advisor",
            "origin": "sim", "source": "MOCK", "context_revision": None,
            "payload": {}, "schema_version": "1.0.0"}


# ---------- F-5: decision_id phải theo bucket của planner, không hardcode 30' ----------

def test_decision_id_bucket_follows_config():
    """`advice.bucket_min=15` ⇒ planner gán 2 lần trong một bucket 30' ⇒ hai phân công
    KHÁC NHAU dùng chung decision_id ⇒ event bị nuốt. Đo được: 23 event mất."""
    c = _cfg_all()
    c.data["advice"]["bucket_min"] = 15
    r = run_once(c, seed=1000)
    sb = [e for e in r.events if e.kind == "standby_followed"]
    ids = [e.detail["decision_id"] for e in sb]
    assert len(set(ids)) == len(ids), (
        f"{len(ids) - len(set(ids))} phân công dùng chung decision_id ⇒ mất dấu")


# ---------- F-7: adapter phải tôn trọng Event.run_id ----------

def test_adapter_uses_event_run_id(run_b):
    """`Event.run_id` là sự thật; tham số chỉ là fallback. Truyền run_id mâu thuẫn
    phải fail-loud, không âm thầm ghi record tự mâu thuẫn."""
    with pytest.raises(ValueError, match="run_id"):
        P.sim_events_to_lifecycle(run_b.events, run_id="TOI-BIA-RA")


def test_adapter_multiday_mixed_runs_ok():
    """Gộp events nhiều ngày (mỗi ngày một run_id) rồi export: mỗi record giữ ĐÚNG
    run_id của ngày nó, không bị ép về một giá trị."""
    from gsm_sim.multiday import run_multiday
    res = run_multiday(_cfg_all(), seed=1000, days=2)
    allev = [e for d in res.days for e in d.events]
    lc = P.sim_events_to_lifecycle(allev)
    assert len({e["run_id"] for e in lc}) == 2
