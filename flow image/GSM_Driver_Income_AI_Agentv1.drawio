 x="42" y="67" width="1250" height="30" as="geometry" /></mxCell><mxCell id="p3-badge" value="L2" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#E2E8F0;strokeColor=#64748B;fontColor=#0F172A;fontSize=11;fontStyle=1;arcSize=25;" vertex="1" parent="1"><mxGeometry x="1410" y="28" width="130" height="38" as="geometry" /></mxCell><mxCell id="p3-line" value="" style="shape=line;strokeColor=#CBD5E1;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="40" y="104" width="1500" height="2" as="geometry" /></mxCell><mxCell id="p3-s1" value="&lt;b&gt;1. MỤC TIÊU&lt;/b&gt;&lt;br&gt;Thu nhập mong muốn&lt;br&gt;+ quỹ thời gian" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#FEF3C7;strokeColor=#D97706;strokeWidth=1.6;fontSize=12;fontColor=#0F172A;arcSize=16;dashed=0;spacing=8;" vertex="1" parent="1"><mxGeometry x="40" y="135" width="165" height="105" as="geometry" /></mxCell><mxCell id="p3-s2" value="&lt;b&gt;2. XÁC NHẬN&lt;/b&gt;&lt;br&gt;Thông tin • consent&lt;br&gt;• preference" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#DBEAFE;strokeColor=#2563EB;strokeWidth=1.6;fontSize=12;fontColor=#0F172A;arcSize=16;dashed=0;spacing=8;" vertex="1" parent="1"><mxGeometry x="240" y="135" width="165" height="105" as="geometry" /></mxCell><mxCell id="p3-s3" value="&lt;b&gt;3. THU THẬP CONTEXT&lt;/b&gt;&lt;br&gt;State + upstream&lt;br&gt;+ provenance" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#DBEAFE;strokeColor=#2563EB;strokeWidth=1.6;fontSize=12;fontColor=#0F172A;arcSize=16;dashed=0;spacing=8;" vertex="1" parent="1"><mxGeometry x="440" y="135" width="165" height="105" as="geometry" /></mxCell><mxCell id="p3-s4" value="&lt;b&gt;4. KIỂM TRA DỮ LIỆU&lt;/b&gt;&lt;br&gt;Đủ • mới • tin cậy?" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#FFEDD5;strokeColor=#EA580C;strokeWidth=1.6;fontSize=12;fontColor=#0F172A;arcSize=16;dashed=0;spacing=8;" vertex="1" parent="1"><mxGeometry x="640" y="135" width="165" height="105" as="geometry" /></mxCell><mxCell id="p3-s5" value="&lt;b&gt;5. BASELINE &amp; GAP&lt;/b&gt;&lt;br&gt;Hiện tại so với&lt;br&gt;mục tiêu" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#FFEDD5;strokeColor=#EA580C;strokeWidth=1.6;fontSize=12;fontColor=#0F172A;arcSize=16;dashed=0;spacing=8;" vertex="1" parent="1"><mxGeometry x="840" y="135" width="165" height="105" as="geometry" /></mxCell><mxCell id="p3-s6" value="&lt;b&gt;6. CƠ HỘI KIỂM SOÁT&lt;/b&gt;&lt;br&gt;Phần nào tài xế&lt;br&gt;có thể tác động?" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#FFEDD5;strokeColor=#EA580C;strokeWidth=1.6;fontSize=12;fontColor=#0F172A;arcSize=16;dashed=0;spacing=8;" vertex="1" parent="1"><mxGeometry x="1040" y="135" width="165" height="105" as="geometry" /></mxCell><mxCell id="p3-s7" value="&lt;b&gt;7. TẠO PHƯƠNG ÁN&lt;/b&gt;&lt;br&gt;What-if cấp cao&lt;br&gt;+ trade-off" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#FFEDD5;strokeColor=#EA580C;strokeWidth=1.6;fontSize=12;fontColor=#0F172A;arcSize=16;dashed=0;spacing=8;" vertex="1" parent="1"><mxGeometry x="1240" y="135" width="165" height="105" as="geometry" /></mxCell><mxCell id="p3-s8" value="&lt;b&gt;8. XẾP HẠNG&lt;/b&gt;&lt;br&gt;Giá trị • confidence&lt;br&gt;• trade-off" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#FFEDD5;strokeColor=#EA580C;strokeWidth=1.6;fontSize=12;fontColor=#0F172A;arcSize=16;dashed=0;spacing=8;" vertex="1" parent="1"><mxGeometry x="1160" y="360" width="175" height="105" as="geometry" /></mxCell><mxCell id="p3-s9" value="&lt;b&gt;9. GUARDRAIL&lt;/b&gt;&lt;br&gt;Pass • veto&lt;br&gt;• human review" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#FEE2E2;strokeColor=#DC2626;strokeWidth=1.6;fontSize=12;fontColor=#0F172A;arcSize=16;dashed=0;spacing=8;" vertex="1" parent="1"><mxGeometry x="940" y="360" width="175" height="105" as="geometry" /></mxCell><mxCell id="p3-s10" value="&lt;b&gt;10. AI GIẢI THÍCH&lt;/b&gt;&lt;br&gt;Ngắn gọn • có căn cứ&lt;br&gt;• nêu bất định" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#EDE9FE;strokeColor=#7C3AED;strokeWidth=1.6;fontSize=12;fontColor=#0F172A;arcSize=16;dashed=0;spacing=8;" vertex="1" parent="1"><mxGeometry x="720" y="360" width="175" height="105" as="geometry" /></mxCell><mxCell id="p3-s11" value="&lt;b&gt;11. TÀI XẾ QUYẾT ĐỊNH&lt;/b&gt;&lt;br&gt;Chọn • điều chỉnh&lt;br&gt;• bỏ qua" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#FEF3C7;strokeColor=#D97706;strokeWidth=1.6;fontSize=12;fontColor=#0F172A;arcSize=16;dashed=0;spacing=8;" vertex="1" parent="1"><mxGeometry x="500" y="360" width="175" height="105" as="geometry" /></mxCell><mxCell id="p3-s12" value="&lt;b&gt;12. ĐO KẾT QUẢ&lt;/b&gt;&lt;br&gt;Kỳ vọng so với&lt;br&gt;thực tế" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#DCFCE7;strokeColor=#16A34A;strokeWidth=1.6;fontSize=12;fontColor=#0F172A;arcSize=16;dashed=0;spacing=8;" vertex="1" parent="1"><mxGeometry x="280" y="360" width="175" height="105" as="geometry" /></mxCell><mxCell id="p3-s13" value="&lt;b&gt;13. CẬP NHẬT EVIDENCE&lt;/b&gt;&lt;br&gt;Sau quality + attribution&lt;br&gt;+ governance" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#DCFCE7;strokeColor=#16A34A;strokeWidth=1.6;fontSize=12;fontColor=#0F172A;arcSize=16;dashed=0;spacing=8;" vertex="1" parent="1"><mxGeometry x="60" y="360" width="175" height="105" as="geometry" /></mxCell><mxCell id="p3-e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#637381;fontSize=12;fontColor=#475569;labelBackgroundColor=#FFFFFF;" edge="1"