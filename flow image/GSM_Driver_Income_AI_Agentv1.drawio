<mxfile host="app.diagrams.net" modified="2026-07-18T10:16:13.794804Z" agent="OpenAI" version="26.0.9" type="device" pages="3" compressed="false"><diagram id="gsm-p1" name="L0 — Tổng quan hệ thống"><mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="900" math="0" shadow="0" background="#FFFFFF"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="p1-title" value="&lt;b&gt;GSM Driver Income AI Agent Architecture&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=27;fontColor=#0F172A;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="24" width="1150" height="42" as="geometry" /></mxCell><mxCell id="p1-subtitle" value="L0 · Tổng quan — từ mục tiêu tài xế đến phương án có kiểm soát và kết quả đo được" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=13;fontColor=#475569;" vertex="1" parent="1"><mxGeometry x="42" y="67" width="1250" height="30" as="geometry" /></mxCell><mxCell id="p1-badge" value="L0" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#E2E8F0;strokeColor=#64748B;fontColor=#0F172A;fontSize=11;fontStyle=1;arcSize=25;" vertex="1" parent="1"><mxGeometry x="1410" y="28" width="130" height="38" as="geometry" /></mxCell><mxCell id="p1-line" value="" style="shape=line;strokeColor=#CBD5E1;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="40" y="104" width="1500" height="2" as="geometry" /></mxCell><mxCell id="p1-north" value="&lt;b&gt;NORTH STAR&lt;/b&gt;&lt;br&gt;Giúp tài xế đạt mục tiêu thu nhập trong quỹ thời gian cố định&lt;br&gt;&lt;font color=&quot;#5F6B76&quot;&gt;mà không can thiệp vào matching, dispatch, giá hoặc routing&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#EAF3FA;strokeColor=#2563EB;strokeWidth=1.6;fontSize=16;fontColor=#0F172A;arcSize=16;dashed=0;spacing=8;" vertex="1" parent="1"><mxGeometry x="300" y="95" width="1000" height="70" as="geometry" /></mxCell><mxCell id="p1-input" value="&lt;b&gt;1. ĐẦU VÀO&lt;/b&gt;&lt;br&gt;&lt;br&gt;• Mục tiêu thu nhập&lt;br&gt;• Quỹ thời gian&lt;br&gt;• Thu nhập hiện tại&lt;br&gt;• Bối cảnh được phép&lt;br&gt;• Phản hồi của tài xế" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fillColor=#FEF3C7;strokeColor=#D97706;strokeWidth=1.6;fontSize=14;fontColor=#0F172A;arcSize=16;dashed=0;spacing=8;" vertex="1" parent="1"><mxGeometry x="45" y="230" width="235" height="245" as="geometry" /></mxCell><mxCell id="p1-boundary" value="&lt;b&gt;HỆ THỐNG AI AGENT HỖ TRỢ THU NHẬP&lt;/b&gt;" style="swimlane;html=1;startSize=42;rounded=1;fillColor=#FFFFFF;strokeColor=#8AA7BD;strokeWidth=2;fontSize=16;fontStyle=1;fontColor=#16324F;horizontal=1;collapsible=0;arcSize=12;" vertex="1" parent="1"><mxGeometry x="330" y="200" width="930" height="380" as="geometry" /></mxCell><mxCell id="p1-flow" value="&lt;b&gt;FLOW ĐIỀU PHỐI&lt;/b&gt;&lt;br&gt;Thu thập → chuẩn hóa → gọi đúng thành phần → fallback" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#DBEAFE;strokeColor=#2563EB;strokeWidth=1.6;fontSize=14;fontColor=#0F172A;arcSize=16;dashed=0;spacing=8;" vertex="1" parent="1"><mxGeometry x="365" y="265" width="245" height="105" as="geometry" /></mxCell><mxCell id="p1-rule" value="&lt;b&gt;RULE / ANALYTICS&lt;/b&gt;&lt;br&gt;Baseline • khoảng cách mục tiêu • what-if • xếp hạng" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#FFEDD5;strokeColor=#EA580C;strokeWidth=1.6;fontSize=14;fontColor=#0F172A;arcSize=16;dashed=0;spacing=8;" vertex="1" parent="1"><mxGeometry x="650" y="265" width="245" height="105" as="geometry" /></mxCell><mxCell id="p1-agent" value="&lt;b&gt;AI AGENT GIỚI HẠN&lt;/b&gt;&lt;br&gt;Hiểu mục tiêu mơ hồ&lt;br&gt;Giải thích phương án dễ hiểu" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#EDE9FE;strokeColor=#7C3AED;strokeWidth=1.6;fontSize=14;fontColor=#0F172A;arcSize=16;dashed=0;spacing=8;" vertex="1" parent="1"><mxGeometry x="935" y="265" width="245" height="105" as="geometry" /></mxCell><mxCell id="p1-gov" value="&lt;b&gt;GUARDRAIL&lt;/b&gt;&lt;br&gt;Policy • an toàn • ranh giới công ty&lt;br&gt;&lt;b&gt;Pass / Veto / Human review&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#FEE2E2;strokeColor=#DC2626;strokeWidth=1.6;fontSize=14;fontColor=#0F172A;arcSize=16;dashed=0;spacing=8;" vertex="1" parent="1"><mxGeometry x="510" y="425" width="280" height="110" as="geometry" /></mxCell><mxCell id="p1-data" value="&lt;b&gt;DỮ LIỆU &amp; TRI THỨC&lt;/b&gt;&lt;br&gt;Session state • lịch sử đã đánh giá&lt;br&gt;policy có phiên bản • upstream được duyệt" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#DCFCE7;strokeColor=#16A34A;strokeWidth=1.6;fontSize=14;fontColor=#0F172A;arcSize=16;dashed=0;spacing=8;" vertex="1" parent="1"><mxGeometry x="825" y="425" width="280" height="110" as="geometry" /></mxCell><mxCell id="p1-output" value="&lt;b&gt;2. ĐẦU RA&lt;/b&gt;&lt;br&gt;&lt;br&gt;1–3 phương án cấp cao&lt;br&gt;• Giá trị kỳ vọng&lt;br&gt;• Độ tin cậy&lt;br&gt;• Bất định&lt;br&gt;• Trade-off&lt;br&gt;&lt;br&gt;&lt;b&gt;Hoặc: Không khuyến nghị&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fillColor=#F1F5F9;strokeColor=#64748B;strokeWidth=1.6;fontSize=14;fontColor=#0F172A;arcSize=16;dashed=0;spacing=8;" vertex="1" parent="1"><mxGeometry x="1310" y="230" width="245" height="245" as="geometry" /></mxCell><mxCell id="p1-driver" value="&lt;b&gt;3. TÀI XẾ QUYẾT ĐỊNH&lt;/b&gt;&lt;br&gt;Chọn • điều chỉnh • bỏ qua&lt;br&gt;&lt;font color=&quot;#5F6B76&quot;&gt;Hệ thống không tự động thực thi&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#FEF3C7;strokeColor=#D97706;strokeWidth=1.6;fontSize=15;fontColor=#0F172A;arcSize=16;dashed=0;spacing=8;" vertex="1" parent="1"><mxGeometry x="1080" y="640" width="380" height="105" as="geometry" /></mxCell><mxCell id="p1-measure" value="&lt;b&gt;4. ĐO &amp; ĐÁNH GIÁ&lt;/b&gt;&lt;br&gt;So sánh kỳ vọng với thực tế → kiểm tra chất lượng và attribution → cập nhật evidence/confidence" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#DCFCE7;strokeColor=#16A34A;strokeWidth=1.6;fontSize=14;fontColor=#0F172A;arcSize=16;dashed=0;spacing=8;" vertex="1" parent="1"><mxGeometry x="425" y="640" width="560" height="105" as="geometry" /></mxCell><mxCell id="p1-scope-in" value="&lt;b&gt;TRONG PHẠM VI&lt;/b&gt;&lt;br&gt;Giải thích thu nhập • khả thi mục tiêu • what-if • phương án cấp cao • trade-off phía tài xế" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fillColor=#EAF7EE;strokeColor=#16A34A;strokeWidth=1.6;fontSize=13;fontColor=#0F172A;arcSize=16;dashed=0;spacing=8;" vertex="1" parent="1"><mxGeometry x="45" y="790" width="710" height="65" as="geometry" /></mxCell><mxCell id="p1-scope-out" value="&lt;b&gt;KHÔNG SỞ HỮU&lt;/b&gt;&lt;br&gt;Matching • Dispatch • Pricing • Routing/ETA • Chọn trạm sạc • Tối ưu marketplace" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fillColor=#FDEEEE;strokeColor=#DC2626;strokeWidth=1.6;fontSize=13;fontColor=#0F172A;arcSize=16;dashed=1;spacing=8;" vertex="1" parent="1"><mxGeometry x="800" y="790" width="755" height="65" as="geometry" /></mxCell><mxCell id="p1-e1" value="mục tiêu + bối cảnh" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#637381;fontSize=12;fontColor=#475569;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="p1-input" target="p1-flow"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p1-e2" value="dữ liệu chuẩn hóa" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#637381;fontSize=12;fontColor=#475569;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="p1-flow" target="p1-rule"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p1-e3" value="scenario có số liệu" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#637381;fontSize=12;fontColor=#475569;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="p1-rule" target="p1-agent"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p1-e4" value="giải thích có cấu trúc" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#637381;fontSize=12;fontColor=#475569;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="p1-agent" target="p1-gov"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p1-e5" value="phương án" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#637381;fontSize=12;fontColor=#475569;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="p1-rule" target="p1-gov"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p1-e6" value="state / facts" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#637381;fontSize=12;fontColor=#475569;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="p1-data" target="p1-flow"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p1-e7" value="pass / veto" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#637381;fontSize=12;fontColor=#475569;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="p1-gov" target="p1-output"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p1-e8" value="lựa chọn + bất định" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#637381;fontSize=12;fontColor=#475569;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="p1-output" target="p1-driver"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p1-e9" value="quyết định + kết quả" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#637381;fontSize=12;fontColor=#475569;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="p1-driver" target="p1-measure"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p1-e10" value="evidence đã đánh giá" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#637381;fontSize=12;fontColor=#475569;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="p1-measure" target="p1-data"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p1-footer" value="Visual architecture v1.0 · conceptual — chưa khóa API, schema vật lý, model/framework, cloud hoặc số lượng agent." style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=11;fontColor=#475569;" vertex="1" parent="1"><mxGeometry x="45" y="862" width="1100" height="22" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram id="gsm-p2" name="L1 — Kiến trúc thành phần"><mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="900" math="0" shadow="0" background="#FFFFFF"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="p2-title" value="&lt;b&gt;GSM Driver Income AI Agent Architecture&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=27;fontColor=#0F172A;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="24" width="1150" height="42" as="geometry" /></mxCell><mxCell id="p2-subtitle" value="L1 · Kiến trúc thành phần — flow-first hybrid, AI giới hạn và dữ liệu có nguồn gốc" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=13;fontColor=#475569;" vertex="1" parent="1"><mxGeometry x="42" y="67" width="1250" height="30" as="geometry" /></mxCell><mxCell id="p2-badge" value="L1" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#E2E8F0;strokeColor=#64748B;fontColor=#0F172A;fontSize=11;fontStyle=1;arcSize=25;" vertex="1" parent="1"><mxGeometry x="1410" y="28" width="130" height="38" as="geometry" /></mxCell><mxCell id="p2-line" value="" style="shape=line;strokeColor=#CBD5E1;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="40" y="104" width="1500" height="2" as="geometry" /></mxCell><mxCell id="p2-lane1" value="TRẢI NGHIỆM &amp; QUYẾT ĐỊNH" style="swimlane;html=1;startSize=38;rounded=1;fillColor=#FFFDF7;strokeColor=#D9C67A;fontSize=14;fontStyle=1;fontColor=#0F172A;horizontal=1;collapsible=0;arcSize=10;" vertex="1" parent="1"><mxGeometry x="35" y="100" width="1530" height="125" as="geometry" /></mxCell><mxCell id="p2-ux" value="&lt;b&gt;UX-01&lt;br&gt;Driver Experience&lt;/b&gt;&lt;br&gt;Nhập mục tiêu • xác nhận • xem phương án" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#FEF3C7;strokeColor=#D97706;strokeWidth=1.6;fontSize=13;fontColor=#0F172A;arcSize=16;dashed=0;spacing=8;" vertex="1" parent="1"><mxGeometry x="75" y="145" width="300" height="60" as="geometry" /></mxCell><mxCell id="p2-human" value="&lt;b&gt;HUM-01&lt;br&gt;Tài xế quyết định&lt;/b&gt;&lt;br&gt;Chọn • điều chỉnh • bỏ qua" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#FEF3C7;strokeColor=#D97706;strokeWidth=1.6;fontSize=13;fontColor=#0F172A;arcSize=16;dashed=0;spacing=8;" vertex="1" parent="1"><mxGeometry x="1190" y="145" width="300" height="60" as="geometry" /></mxCell><mxCell id="p2-lane2" value="FLOW &amp; ORCHESTRATION" style="swimlane;html=1;startSize=38;rounded=1;fillColor=#F7FBFE;strokeColor=#8EB6D1;fontSize=14;fontStyle=1;fontColor=#0F172A;horizontal=1;collapsible=0;arcSize=10;" vertex="1" parent="1"><mxGeometry x="35" y="240" width="1530" height="130" as="geometry" /></mxCell><mxCell id="p2-orch" value="&lt;b&gt;FLOW-01 — Controlled Flow Orchestrator&lt;/b&gt;&lt;br&gt;State • routing • approval • retry • fallback • audit trace" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#DBEAFE;strokeColor=#2563EB;strokeWidth=1.6;fontSize=14;fontColor=#0F172A;arcSize=16;dashed=0;spacing=8;" vertex="1" parent="1"><mxGeometry x="420" y="285" width="740" height="65" as="geometry" /></mxCell><mxCell id="p2-lane3" value="NĂNG LỰC PHÂN TÍCH &amp; AI" style="swimlane;html=1;startSize=38;rounded=1;fillColor=#FFFFFF;strokeColor=#B8C0C8;fontSize=14;fontStyle=1;fontColor=#0F172A;horizontal=1;collapsible=0;arcSize=10;" vertex="1" parent="1"><mxGeometry x="35" y="385" width="1530" height="180" as="geometry" /></mxCell><mxCell id="p2-analytics" value="&lt;b&gt;RULE-01&lt;br&gt;Income Analytics&lt;/b&gt;&lt;br&gt;Baseline &amp; chỉ số" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#FFEDD5;strokeColor=#EA580C;strokeWidth=1.6;fontSize=13;fontColor=#0F172A;arcSize=16;dashed=0;spacing=8;" vertex="1" parent="1"><mxGeometry x="75" y="430" width="240" height="85" as="geometry" /></mxCell><mxCell id="p2-feas" value="&lt;b&gt;RULE-02&lt;br&gt;Goal Feasibility&lt;/b&gt;&lt;br&gt;Khoảng cách &amp; what-if" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#FFEDD5;strokeColor=#EA580C;strokeWidth=1.6;fontSize=13;fontColor=#0F172A;arcSize=16;dashed=0;spacing=8;" vertex="1" parent="1"><mxGeometry x="345" y="430" width="240" height="85" as="geometry" /></mxCell><mxCell id="p2-rank" value="&lt;b&gt;RULE-03&lt;br&gt;Option Ranker&lt;/b&gt;&lt;br&gt;Giá trị • confidence • trade-off" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#FFEDD5;strokeColor=#EA580C;strokeWidth=1.6;fontSize=13;fontColor=#0F172A;arcSize=16;dashed=0;spacing=8;" vertex="1" parent="1"><mxGeometry x="615" y="430" width="240" height="85" as="geometry" /></mxCell><mxCell id="p2-agent" value="&lt;b&gt;AGENT-01&lt;br&gt;Contextual Interpreter&lt;/b&gt;&lt;br&gt;Hiểu mơ hồ • giải thích có căn cứ" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#EDE9FE;strokeColor=#7C3AED;strokeWidth=1.6;fontSize=13;fontColor=#0F172A;arcSize=16;dashed=0;spacing=8;" vertex="1" parent="1"><mxGeometry x="885" y="430" width="280" height="85" as="geometry" /></mxCell><mxCell id="p2-gov" value="&lt;b&gt;GOV-01&lt;br&gt;Policy &amp; Alignment Gate&lt;/b&gt;&lt;br&gt;Allow • veto • human review" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#FEE2E2;strokeColor=#DC2626;strokeWidth=1.6;fontSize=13;fontColor=#0F172A;arcSize=16;dashed=0;spacing=8;" vertex="1" parent="1"><mxGeometry x="1195" y="430" width="285" height="85" as="geometry" /></mxCell><mxCell id="p2-lane4" value="STATE • MEMORY • KNOWLEDGE • UPSTREAM" style="swimlane;html=1;startSize=38;rounded=1;fillColor=#F8FCF9;strokeColor=#8DB79A;fontSize=14;fontStyle=1;fontColor=#0F172A;horizontal=1;collapsible=0;arcSize=10;" vertex="1" parent="1"><mxGeometry x="35" y="580" width="1530" height="185" as="geometry" /></mxCell><mxCell id="p2-session" value="&lt;b&gt;DATA-01&lt;br&gt;Session State&lt;/b&gt;&lt;br&gt;Chỉ phiên hiện tại" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#DCFCE7;strokeColor=#16A34A;strokeWidth=1.6;fontSize=13;fontColor=#0F172A;arcSize=16;dashed=0;spacing=8;" vertex="1" parent="1"><mxGeometry x="75" y="630" width="240" height="85" as="geometry" /></mxCell><mxCell id="p2-history" value="&lt;b&gt;DATA-02&lt;br&gt;Driver History &amp; Outcomes&lt;/b&gt;&lt;br&g