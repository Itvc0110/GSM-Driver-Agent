ml=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#637381;fontSize=12;fontColor=#475569;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="p3-s13" target="p3-s3"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="145" y="600" /><mxPoint x="520" y="600" /></Array></mxGeometry></mxCell><mxCell id="p3-b1" value="&lt;b&gt;KHÔNG ĐỦ DỮ LIỆU&lt;/b&gt;&lt;br&gt;Unknown / cần bổ sung&lt;br&gt;Không đoán" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#F1F5F9;strokeColor=#64748B;strokeWidth=1.6;fontSize=12;fontColor=#0F172A;arcSize=16;dashed=1;spacing=8;" vertex="1" parent="1"><mxGeometry x="535" y="615" width="235" height="85" as="geometry" /></mxCell><mxCell id="p3-b2" value="&lt;b&gt;KHÔNG CÓ CƠ HỘI KIỂM SOÁT&lt;/b&gt;&lt;br&gt;Hiển thị baseline&lt;br&gt;Không khuyến nghị" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#F1F5F9;strokeColor=#64748B;strokeWidth=1.6;fontSize=12;fontColor=#0F172A;arcSize=16;dashed=1;spacing=8;" vertex="1" parent="1"><mxGeometry x="790" y="615" width="250" height="85" as="geometry" /></mxCell><mxCell id="p3-b3" value="&lt;b&gt;ĐỘ TIN CẬY THẤP&lt;/b&gt;&lt;br&gt;So sánh thận trọng&lt;br&gt;Nêu rõ bất định" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#FFF7E6;strokeColor=#EA580C;strokeWidth=1.6;fontSize=12;fontColor=#0F172A;arcSize=16;dashed=1;spacing=8;" vertex="1" parent="1"><mxGeometry x="1060" y="615" width="225" height="85" as="geometry" /></mxCell><mxCell id="p3-b4" value="&lt;b&gt;VI PHẠM POLICY / RANH GIỚI&lt;/b&gt;&lt;br&gt;Veto hoặc chuyển&lt;br&gt;human review" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#FEE2E2;strokeColor=#DC2626;strokeWidth=1.6;fontSize=12;fontColor=#0F172A;arcSize=16;dashed=1;spacing=8;" vertex="1" parent="1"><mxGeometry x="1305" y="615" width="250" height="85" as="geometry" /></mxCell><mxCell id="p3-b-e1" value="không" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.8;strokeColor=#8995A1;dashed=1;fontSize=11;fontColor=#5F6B76;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="p3-s4" target="p3-b1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p3-b-e2" value="không" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.8;strokeColor=#8995A1;dashed=1;fontSize=11;fontColor=#5F6B76;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="p3-s6" target="p3-b2"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p3-b-e3" value="low confidence" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.8;strokeColor=#8995A1;dashed=1;fontSize=11;fontColor=#5F6B76;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="p3-s8" target="p3-b3"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p3-b-e4" value="veto / review" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.8;strokeColor=#8995A1;dashed=1;fontSize=11;fontColor=#5F6B76;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="p3-s9" target="p3-b4"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p3-principles" value="&lt;b&gt;Nguyên tắc kết thúc an toàn&lt;/b&gt;&lt;br&gt;Không đủ dữ liệu → không đoán | Không có cơ hội kiểm soát → không khuyến nghị | Tài xế bỏ qua → ghi nhận trung lập, không phạt | Chênh lệch lớn → đưa vào evaluation backlog, không học một lần." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fillColor=#F7F8FA;strokeColor=#A7B0BA;strokeWidth=1.6;fontSize=12;fontColor=#0F172A;arcSize=16;dashed=0;spacing=8;" vertex="1" parent="1"><mxGeometry x="60" y="760" width="1495" height="70" as="geometry" /></mxCell><mxCell id="p3-footer" value="Visual architecture v1.0 · conceptual — các nhánh lỗi kết thúc an toàn, không suy đoán và không tự động thực thi." style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=11;fontColor=#475569;" vertex="1" parent="1"><mxGeometry x="45" y="862" width="1150" height="22" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>