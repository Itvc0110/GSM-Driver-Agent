        <mxCell id="pr" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fillColor=#F7F8FA;strokeColor=#A7B0BA;strokeWidth=1.4;fontSize=12;fontColor=#0F172A;arcSize=12;spacing=8;" value="&lt;b&gt;Kết thúc an toàn:&lt;/b&gt; thiếu dữ liệu → không đoán | không cơ hội → không khuyến nghị | tài xế bỏ qua → ghi nhận trung lập, không phạt | chênh lệch lớn → đưa vào evaluation backlog." vertex="1">
          <mxGeometry height="50" width="1350" x="90" y="720" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="v2-F0" name="F0 — Hỏi đáp chính sách">
    <mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="900" math="0" shadow="0" background="#FFFFFF">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="t" value="&lt;b&gt;F0 — Hỏi đáp chính sách theo hồ sơ tài xế&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=24;fontColor=#0F172A;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="24" width="1100" height="38" as="geometry" />
        </mxCell>
        <mxCell id="s" value="Trả lời chính sách/thưởng/phạt hiện hành, cá nhân hóa theo hồ sơ, luôn kèm nguồn trích dẫn + effective date. Nét đứt = nguồn cộng đồng (tương lai)." style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=13;fontColor=#475569;" vertex="1" parent="1">
          <mxGeometry x="42" y="64" width="1320" height="26" as="geometry" />
        </mxCell>
        <mxCell id="b" value="F0" style="rounded=1;whiteSpace=wrap;html=1;align=center;fillColor=#DCFCE7;strokeColor=#16A34A;fontColor=#0F172A;fontSize=11;fontStyle=1;arcSize=25;" vertex="1" parent="1">
          <mxGeometry x="1460" y="26" width="90" height="36" as="geometry" />
        </mxCell>
        <mxCell id="ln" value="" style="shape=line;strokeColor=#CBD5E1;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="40" y="102" width="1510" height="2" as="geometry" />
        </mxCell>
        <mxCell id="f1" value="&lt;b&gt;1. Tài xế hỏi&lt;/b&gt;&lt;br&gt;&quot;Thưởng tuần của tôi tính sao?&quot; · &quot;Vì sao bị trừ tiền?&quot;" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#FEF3C7;strokeColor=#D97706;strokeWidth=1.6;fontSize=13;fontColor=#0F172A;arcSize=16;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="60" y="150" width="230" height="90" as="geometry" />
        </mxCell>
        <mxCell id="f2" value="&lt;b&gt;2. Orchestrator&lt;/b&gt;&lt;br&gt;Nhận diện hồ sơ (track/thâm niên/tỷ lệ) + intent" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#DBEAFE;strokeColor=#2563EB;strokeWidth=1.6;fontSize=13;fontColor=#0F172A;arcSize=16;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="350" y="150" width="230" height="90" as="geometry" />
        </mxCell>
        <mxCell id="f3" value="&lt;b&gt;3. Truy xuất Policy KB&lt;/b&gt;&lt;br&gt;versioned + effective date + citation (research/policy)" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#DCFCE7;strokeColor=#16A34A;strokeWidth=1.6;fontSize=13;fontColor=#0F172A;arcSize=16;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="640" y="150" width="230" height="90" as="geometry" />
        </mxCell>
        <mxCell id="f4" value="&lt;b&gt;4. AI Agent&lt;/b&gt;&lt;br&gt;Hiểu intent • tổng hợp • so sánh • diễn đạt từ facts đã truy xuất&lt;br&gt;&lt;font color=&quot;#6D28D9&quot;&gt;không suy policy khi KB thiếu&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#EDE9FE;strokeColor=#7C3AED;strokeWidth=1.6;fontSize=12;fontColor=#0F172A;arcSize=16;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="930" y="150" width="240" height="90" as="geometry" />
        </mxCell>
        <mxCell id="f5" value="&lt;b&gt;5. GUARDRAIL&lt;/b&gt;&lt;br&gt;Bắt buộc citation • cấm bịa • gắn version&lt;br&gt;không dạy lách phạt" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#FEE2E2;strokeColor=#DC2626;strokeWidth=1.6;fontSize=13;fontColor=#0F172A;arcSize=16;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="930" y="330" width="240" height="90" as="geometry" />
        </mxCell>
        <mxCell id="f6" value="&lt;b&gt;6. Trả lời&lt;/b&gt;&lt;br&gt;Câu trả lời cá nhân hóa + nguồn trích dẫn + ngày hiệu lực" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#F1F5F9;strokeColor=#64748B;strokeWidth=1.6;fontSize=13;fontColor=#0F172A;arcSize=16;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="620" y="330" width="240" height="90" as="geometry" />
        </mxCell>
        <mxCell id="fcomm" value="&lt;b&gt;Nguồn cộng đồng&lt;/b&gt; → &lt;b&gt;Lọc rủi ro&lt;/b&gt;&lt;br&gt;bổ sung ngữ cảnh, KHÔNG thay policy&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;◇ TƯƠNG LAI&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#FEF2F2;strokeColor=#DC2626;strokeWidth=1.4;fontSize=12;fontColor=#0F172A;arcSize=16;dashed=1;dashPattern=6 4;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="930" y="490" width="240" height="80" as="geometry" />
        </mxCell>
        <mxCell id="ffb" value="&lt;b&gt;FALLBACK · Thiếu fact/citation/version&lt;/b&gt;&lt;br&gt;Nói rõ chưa đủ dữ liệu + dẫn kênh official; không suy policy" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#F1F5F9;strokeColor=#64748B;strokeWidth=1.4;fontSize=12;fontColor=#0F172A;arcSize=16;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="620" y="490" width="240" height="80" as="geometry" />
        </mxCell>
        <mxCell id="g1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#637381;" edge="1" parent="1" source="f1" target="f2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="g2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#637381;" edge="1" parent="1" source="f2" target="f3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="g3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#637381;" edge="1" parent="1" source="f3" target="f4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="g4" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#637381;" edge="1" parent="1" source="f4" target="f5">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="g5" value="pass" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#637381;fontSize=11;fontColor=#475569;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="f5" target="f6">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="g6" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.6;strokeColor=#94A3B8;dashed=1;dashPattern=6 4;" edge="1" parent="1" source="fcomm" target="f4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="g7" value="veto / thiếu" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.6;strokeColor=#8995A1;fontSize=11;fontColor=#5F6B76;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="f5" target="ffb">
