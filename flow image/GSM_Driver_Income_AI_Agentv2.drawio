  <diagram id="v2-F0" name="F0 — Hỏi đáp chính sách">
    <mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="900" math="0" shadow="0" background="#FFFFFF">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="t" value="&lt;b&gt;F0 — Hỏi đáp chính sách theo hồ sơ tài xế&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=24;fontColor=#0F172A;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="24" width="1100" height="38" as="geometry" /></mxCell>
        <mxCell id="s" value="Trả lời chính sách/thưởng/phạt hiện hành, cá nhân hóa theo hồ sơ, luôn kèm nguồn trích dẫn + effective date. Nét đứt = nguồn cộng đồng (tương lai)." style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=13;fontColor=#475569;" vertex="1" parent="1"><mxGeometry x="42" y="64" width="1320" height="26" as="geometry" /></mxCell>
        <mxCell id="b" value="F0" style="rounded=1;whiteSpace=wrap;html=1;align=center;fillColor=#DCFCE7;strokeColor=#16A34A;fontColor=#0F172A;fontSize=11;fontStyle=1;arcSize=25;" vertex="1" parent="1"><mxGeometry x="1460" y="26" width="90" height="36" as="geometry" /></mxCell>
        <mxCell id="ln" value="" style="shape=line;strokeColor=#CBD5E1;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="40" y="102" width="1510" height="2" as="geometry" /></mxCell>
        <mxCell id="f1" value="&lt;b&gt;1. Tài xế hỏi&lt;/b&gt;&lt;br&gt;&quot;Thưởng tuần của tôi tính sao?&quot; · &quot;Vì sao bị trừ tiền?&quot;" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#FEF3C7;strokeColor=#D97706;strokeWidth=1.6;fontSize=13;fontColor=#0F172A;arcSize=16;spacing=6;" vertex="1" parent="1"><mxGeometry x="60" y="150" width="230" height="90" as="geometry" /></mxCell>
        <mxCell id="f2" value="&lt;b&gt;2. Orchestrator&lt;/b&gt;&lt;br&gt;Nhận diện hồ sơ (track/thâm niên/tỷ lệ) + intent" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#DBEAFE;strokeColor=#2563EB;strokeWidth=1.6;fontSize=13;fontColor=#0F172A;arcSize=16;spacing=6;" vertex="1" parent="1"><mxGeometry x="350" y="150" width="230" height="90" as="geometry" /></mxCell>
        <mxCell id="f3" value="&lt;b&gt;3. Truy xuất Policy KB&lt;/b&gt;&lt;br&gt;versioned + effective date + citation (research/policy)" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#DCFCE7;strokeColor=#16A34A;strokeWidth=1.6;fontSize=13;fontColor=#0F172A;arcSize=16;spacing=6;" vertex="1" parent="1"><mxGeometry x="640" y="150" width="230" height="90" as="geometry" /></mxCell>
        <mxCell id="f4" value="&lt;b&gt;4. AI Agent&lt;/b&gt;&lt;br&gt;Tổng hợp + cá nhân hóa theo hồ sơ&lt;br&gt;&lt;font color=&quot;#6D28D9&quot;&gt;reasoning điều kiện nếu KB chưa phủ&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#EDE9FE;strokeColor=#7C3AED;strokeWidth=1.6;fontSize=13;fontColor=#0F172A;arcSize=16;spacing=6;" vertex="1" parent="1"><mxGeometry x="930" y="150" width="240" height="90" as="geometry" /></mxCell>
        <mxCell id="f5" value="&lt;b&gt;5. GUARDRAIL&lt;/b&gt;&lt;br&gt;Bắt buộc citation • cấm bịa • gắn version&lt;br&gt;không dạy lách phạt" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#FEE2E2;strokeColor=#DC2626;strokeWidth=1.6;fontSize=13;fontColor=#0F172A;arcSize=16;spacing=6;" vertex="1" parent="1"><mxGeometry x="930" y="330" width="240" height="90" as="geometry" /></mxCell>
        <mxCell id="f6" value="&lt;b&gt;6. Trả lời&lt;/b&gt;&lt;br&gt;Câu trả lời cá nhân hóa + nguồn trích dẫn + ngày hiệu lực" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#F1F5F9;strokeColor=#64748B;strokeWidth=1.6;fontSize=13;fontColor=#0F172A;arcSize=16;spacing=6;" vertex="1" parent="1"><mxGeometry x="620" y="330" width="240" height="90" as="geometry" /></mxCell>
        <mxCell id="fcomm" value="&lt;b&gt;Nguồn cộng đồng&lt;/b&gt; → &lt;b&gt;Lọc rủi ro&lt;/b&gt;&lt;br&gt;bổ sung ngữ cảnh, KHÔNG thay policy&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;◇ TƯƠNG LAI&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#FEF2F2;strokeColor=#DC2626;strokeWidth=1.4;fontSize=12;fontColor=#0F172A;arcSize=16;dashed=1;dashPattern=6 4;spacing=6;" vertex="1" parent="1"><mxGeometry x="930" y="490" width="240" height="80" as="geometry" /></mxCell>
        <mxCell id="ffb" value="&lt;b&gt;Thiếu / không chắc&lt;/b&gt;&lt;br&gt;Nói rõ chưa chắc + hướng dẫn kênh chính thức (fallback template)" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#F1F5F9;strokeColor=#64748B;strokeWidth=1.4;fontSize=12;fontColor=#0F172A;arcSize=16;dashed=1;spacing=6;" vertex="1" parent="1"><mxGeometry x="620" y="490" width="240" height="80" as="geometry" /></mxCell>
        <mxCell id="g1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#637381;" edge="1" parent="1" source="f1" target="f2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="g2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#637381;" edge="1" parent="1" source="f2" target="f3"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="g3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#637381;" edge="1" parent="1" source="f3" target="f4"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="g4" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#637381;" edge="1" parent="1" source="f4" target="f5"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="g5" value="pass" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#637381;fontSize=11;fontColor=#475569;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="f5" target="f6"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="g6" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.6;strokeColor=#94A3B8;dashed=1;dashPattern=6 4;" edge="1" parent="1" source="fcomm" target="f4"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="g7" value="veto / thiếu" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.6;strokeColor=#8995A1;dashed=1;fontSize=11;fontColor=#5F6B76;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="f5" target="ffb"><mxGeometry relative="1" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="v2-F1" name="F1 — Trước ca">
    <mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="900" math="0" shadow="0" background="#FFFFFF">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="t" value="&lt;b&gt;F1 — Trước ca (khi tài xế mở app)&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=24;fontColor=#0F172A;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="24" width="1100" height="38" as="geometry" /></mxCell>
        <mxCell id="s" value="Chủ động nhắc chính sách/thưởng mới; đề xuất &amp;amp; nhận xét chỉ tiêu net theo hồ sơ; lộ trình đạt mốc thưởng tuần." style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=13;fontColor=#475569;" vertex="1" parent="1"><mxGeometry x="42" y="64" width="1320" height="26" as="geometry" /></mxCell>
        <mxCell id="b" value="F1" style="rounded=1;whiteSpace=wrap;html=1;align=center;fillColor=#FEF3C7;strokeColor=#D97706;fontColor=#0F172A;fontSize=11;fontStyle=1;arcSize=25;" vertex="1" parent="1"><mxGeometry x="1460" y="26" width="90" height="36" as="geometry" /></mxCell>
        <mxCell id="ln" value="" style="shape=line;strokeColor=#CBD5E1;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="40" y="102" width="1510" height="2" as="geometry" /></mxCell>
        <mxCell id="f1" value="&lt;b&gt;1. Mở app&lt;/b&gt;&lt;br&gt;Bắt đầu phiên trước ca" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#FEF3C7;strokeColor=#D97706;strokeWidth=1.6;fontSize=13;fontColor=#0F172A;arcSize=16;spacing=6;" vertex="1" parent="1"><mxGeometry x="60" y="150" width="210" height="90" as="geometry" /></mxCell>
        <mxCell id="f2" value="&lt;b&gt;2. Cập nhật chủ động&lt;/b&gt;&lt;br&gt;Chính sách/thưởng mới, giới hạn mới áp cho hồ sơ này (từ Policy KB)" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#DCFCE7;strokeColor=#16A34A;strokeWidth=1.6;fontSize=13;fontColor=#0F172A;arcSize=16;spacing=6;" vertex="1" parent="1"><mxGeometry x="330" y="150" width="230" height="90" as="geometry" /></mxCell>
        <mxCell id="f3" value="&lt;b&gt;3. Đề xuất chỉ tiêu net&lt;/b&gt;&lt;br&gt;Mặc định từ policy + hồ sơ (net = tiền thực nhận)" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#FFEDD5;strokeColor=#EA580C;strokeWidth=1.6;fontSize=13;fontColor=#0F172A;arcSize=16;spacing=6;" vertex="1" parent="1"><mxGeometry x="620" y="150" width="230" height="90" as="geometry" /></mxCell>
        <mxCell id="f4" value="&lt;b&gt;4. Tài xế chỉnh chỉ tiêu&lt;/b&gt;&lt;br&gt;Điều chỉnh mục tiêu/quỹ giờ" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#FEF3C7;strokeColor=#D97706;strokeWidth=1.6;fontSize=13;fontColor=#0F172A;arcSize=16;spacing=6;" vertex="1" parent="1"><mxGeometry x="910" y="150" width="230" height="90" as="geometry" /></mxCell>
        <mxCell id="f5" value="&lt;b&gt;5. Agent nhận xét&lt;/b&gt;&lt;br&gt;Cao/thấp so hồ sơ (part-time ≠ full-time) + khuyên điều chỉnh" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#EDE9FE;strokeColor=#7C3AED;strokeWidth=1.6;fontSize=13;fontColor=#0F172A;arcSize=16;spacing=6;" vertex="1" parent="1"><mxGeometry x="910" y="330" width="230" height="90" as="geometry" /></mxCell>
        <mxCell id="f6" value="&lt;b&gt;6. Lộ trình đạt mốc thưởng&lt;/b&gt;&lt;br&gt;Điểm 10đ (6–8h,16–18h) / 5đ giờ thường; mốc tuần 400/700/1.100/1.400" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#FFEDD5;strokeColor=#EA580C;strokeWidth=1.6;fontSize=12;fontColor=#0F172A;arcSize=16;spacing=6;" vertex="1" parent="1"><mxGeometry x="600" y="330" width="250" height="90" as="geometry" /></mxCell>
        <mxCell id="f7" value="&lt;b&gt;7. GUARDRAIL&lt;/b&gt;&lt;br&gt;Không hứa chắc thu nhập • nêu điều kiện • không ép tăng giờ/bỏ nghỉ" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#FEE2E2;strokeColor=#DC2626;strokeWidth=1.6;fontSize=13;fontColor=#0F172A;arcSize=16;spacing=6;" vertex="1" parent="1"><mxGeometry x="330" y="330" width="240" height="90" as="geometry" /></mxCell>
        <mxCell id="f8" value="&lt;b&gt;8. Tài xế chọn kế hoạch&lt;/b&gt;&lt;br&gt;Chốt chỉ tiêu + lộ trình cho ca" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#F1F5F9;strokeColor=#64748B;strokeWidth=1.6;fontSize=13;fontColor=#0F172A;arcSize=16;spacing=6;" vertex="1" parent="1"><mxGeometry x="60" y="330" width="240" height="90" as="geometry" /></mxCell>
        <mxCell id="g1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#637381;" edge="1" parent="1" source="f1" target="f2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="g2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#637381;" edge="1" parent="1" source="f2" target="f3"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="g3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#637381;" edge="1" parent="1" source="f3" target="f4"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="g4" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#637381;" edge="1" parent="1" source="f4" target="f5"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="g5" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#637381;" edge="1" parent="1" source="f5" target="f6"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="g6" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#637381;" edge="1" parent="1" source="f6" target="f7"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="g7" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#637381;" edge="1" parent="1" source="f7" target="f8"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="gb" value="chỉnh lại" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.6;strokeColor=#8995A1;dashed=1;fontSize=11;fontColor=#5F6B76;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="f5" target="f4"><mxGeometry relative="1" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="v2-F2" name="F2 — Trong ca">
    <mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="900" math="0" shadow="0" background="#FFFFFF">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="t" value="&lt;b&gt;F2 — Trong ca&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=24;fontColor=#0F172A;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="24" width="1100" height="38" as="geometry" /></mxCell>
        <mxCell id="s" value="Dựa state số đơn theo khu vực × giờ (mock) → khuyên lộ trình chạy/nghỉ/sạc + voucher; giữ ngưỡng kỷ luật. Nét đứt = state pin (tương lai)." style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=13;fontColor=#475569;" vertex="1" parent="1"><mxGeometry x="42" y="64" width="1340" height="26" as="geometry" /></mxCell>
        <mxCell id="b" value="F2" style="rounded=1;whiteSpace=wrap;html=1;align=center;fillColor=#DBEAFE;strokeColor=#2563EB;fontColor=#0F172A;fontSize=11;fontStyle=1;arcSize=25;" vertex="1" parent="1"><mxGeometry x="1460" y="26" width="90" height="36" as="geometry" /></mxCell>
        <mxCell id="ln" value="" style="shape=line;strokeColor=#CBD5E1;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="40" y="102" width="1510" height="2" as="geometry" /></mxCell>
        <mxCell id="f1" value="&lt;b&gt;1. State đơn theo khu vực × giờ&lt;/b&gt;&lt;br&gt;Mock phân phối (giờ × ngày × vị trí)" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#DCFCE7;strokeColor=#16A34A;strokeWidth=1.6;fontSize=13;fontColor=#0F172A;arcSize=16;spacing=6;" vertex="1" parent="1"><mxGeometry x="60" y="150" width="240" height="90" as="geometry" /></mxCell>
        <mxCell id="fpin" value="&lt;b&gt;State pin xe&lt;/b&gt;&lt;br&gt;SOC • tầm hoạt động&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;◇ TƯƠNG LAI&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#F0FDF4;strokeColor=#16A34A;strokeWidth=1.4;fontSize=12;fontColor=#0F172A;arcSize=16;dashed=1;dashPattern=6 4;spacing=6;" vertex="1" parent="1"><mxGeometry x="60" y="290" width="240" height="70" as="geometry" /></mxCell>
        <mxCell id="f2" value="&lt;b&gt;2. Phân tích cơ hội&lt;/b&gt;&lt;br&gt;Khung giờ đông/vắng • sạc lệch đỉnh • gần mốc thưởng" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#FFEDD5;strokeColor=#EA580C;strokeWidth=1.6;fontSize=13;fontColor=#0F172A;arcSize=16;spacing=6;" vertex="1" parent="1"><mxGeometry x="360" y="150" width="240" height="90" as="geometry" /></mxCell>
        <mxCell id="f3" value="&lt;b&gt;3. Khuyên lộ trình thời gian&lt;/b&gt;&lt;br&gt;Khi nào chạy / nghỉ / sạc (giờ thấp điểm)" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#EDE9FE;strokeColor=#7C3AED;strokeWidth=1.6;fontSize=13;fontColor=#0F172A;arcSize=16;spacing=6;" vertex="1" parent="1"><mxGeometry x="660" y="150" width="240" height="90" as="geometry" /></mxCell>
        <mxCell id="f4" value="&lt;b&gt;4. Cập nhật voucher&lt;/b&gt;&lt;br&gt;Ưu đãi mới trong ca" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#DCFCE7;strokeColor=#16A34A;strokeWidth=1.6;fontSize=13;fontColor=#0F172A;arcSize=16;spacing=6;" vertex="1" parent="1"><mxGeometry x="960" y="150" width="220" height="90" as="geometry" /></mxCell>
        <mxCell id="f5" value="&lt;b&gt;5. GUARDRAIL&lt;/b&gt;&lt;br&gt;Ngưỡng kỷ luật ≥70% nhận/hoàn thành • không khuyên nhận/từ chối cuốc cụ thể • không ép bỏ nghỉ" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#FEE2E2;strokeColor=#DC2626;strokeWidth=1.6;fontSize=13;fontColor=#0F172A;arcSize=16;spacing=6;" vertex="1" parent="1"><mxGeometry x="860" y="330" width="320" height="90" as="geometry" /></mxCell>
        <mxCell id="f6" value="&lt;b&gt;6. Card gợi ý&lt;/b&gt;&lt;br&gt;1 hành động chính + giải thích + expiry" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#F1F5F9;strokeColor=#64748B;strokeWidth=1.6;fontSize=13;fontColor=#0F172A;arcSize=16;spacing=6;" vertex="1" parent="1"><mxGeometry x="500" y="330" width="240" height="90" as="geometry" /></mxCell>
        <mxCell id="f7" value="&lt;b&gt;7. Tài xế quyết định&lt;/b&gt;&lt;br&gt;Làm theo / bỏ qua" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#FEF3C7;strokeColor=#D97706;strokeWidth=1.6;fontSize=13;fontColor=#0F172A;arcSize=16;spacing=6;" vertex="1" parent="1"><mxGeometry x="160" y="330" width="220" height="90" as="geometry" /></mxCell>
        <mxCell id="g1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#637381;" edge="1" parent="1" source="f1" target="f2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="gpin" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.6;strokeColor=#94A3B8;dashed=1;dashPattern=6 4;" edge="1" parent="1" source="fpin" target="f2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="g2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#637381;" edge="1" parent="1" source="f2" target="f3"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="g3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#637381;" edge="1" parent="1" source="f3" target="f4"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="g4" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#637381;" edge="1" parent="1" source="f4" target="f5"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="g5" value="pass" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#637381;fontSize=11;fontColor=#475569;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="f5" target="f6"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="g6" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#637381;" edge="1" parent="1" source="f6" target="f7"><mxGeometry relative="1" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="v2-F3" name="F3 — Sau ca">
    <mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="900" math="0" shadow="0" background="#FFFFFF">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="t" value="&lt;b&gt;F3 — Sau ca (analyzer + advisor)&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=24;fontColor=#0F172A;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="24" width="1100" height="38" as="geometry" /></mxCell>
        <mxCell id="s" value="Tổng hợp hành vi trong ca → phát hiện điểm chưa tối ưu → 1 bài học cụ thể cho ca tới. Reconcile với ledger, không phạt tài xế." style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=13;fontColor=#475569;" vertex="1" parent="1"><mxGeometry x="42" y="64" width="1340" height="26" as="geometry" /></mxCell>
        <mxCell id="b" value="F3" style="rounded=1;whiteSpace=wrap;html=1;align=center;fillColor=#DCFCE7;strokeColor=#16A34A;fontColor=#0F172A;fontSize=11;fontStyle=1;arcSize=25;" vertex="1" parent="1"><mxGeometry x="1460" y="26" width="90" height="36" as="geometry" /></mxCell>
        <mxCell id="ln" value="" style="shape=line;strokeColor=#CBD5E1;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="40" y="102" width="1510" height="2" as="geometry" /></mxCell>
        <mxCell id="f1" value="&lt;b&gt;1. Tổng hợp ca&lt;/b&gt;&lt;br&gt;Ledger + thời gian + cuốc + sạc + tỷ lệ nhận/hoàn thành" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#DCFCE7;strokeColor=#16A34A;strokeWidth=1.6;fontSize=13;fontColor=#0F172A;arcSize=16;spacing=6;" vertex="1" parent="1"><mxGeometry x="60" y="150" width="240" height="90" as="geometry" /></mxCell>
        <mxCell id="f2" value="&lt;b&gt;2. Analyzer&lt;/b&gt;&lt;br&gt;So kế hoạch + comparable self-days (rule/analytics)" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#FFEDD5;strokeColor=#EA580C;strokeWidth=1.6;fontSize=13;fontColor=#0F172A;arcSize=16;spacing=6;" vertex="1" parent="1"><mxGeometry x="360" y="150" width="240" height="90" as="geometry" /></mxCell>
        <mxCell id="f3" value="&lt;b&gt;3. Phát hiện chưa tối ưu&lt;/b&gt;&lt;br&gt;Sạc giờ cao điểm • thiếu điểm tới mốc • tỷ lệ nhận gần ngưỡng • từ chối nhiều" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#FFEDD5;strokeColor=#EA580C;strokeWidth=1.6;fontSize=12;fontColor=#0F172A;arcSize=16;spacing=6;" vertex="1" parent="1"><mxGeometry x="660" y="150" width="250" height="90" as="geometry" /></mxCell>
        <mxCell id="f4" value="&lt;b&gt;4. Chọn 1–3 driver of outcome&lt;/b&gt;&lt;br&gt;Yếu tố ảnh hưởng lớn nhất" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#FFEDD5;strokeColor=#EA580C;strokeWidth=1.6;fontSize=13;fontColor=#0F172A;arcSize=16;spacing=6;" vertex="1" parent="1"><mxGeometry x="970" y="150" width="230" height="90" as="geometry" /></mxCell>
        <mxCell id="f5" value="&lt;b&gt;5. AI giải thích + 1 bài học&lt;/b&gt;&lt;br&gt;Explicit, dễ hiểu • 1 thay đổi cho ca tới&lt;br&gt;&lt;font color=&quot;#6D28D9&quot;&gt;reasoning điều kiện (log)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#EDE9FE;strokeColor=#7C3AED;strokeWidth=1.6;fontSize=13;fontColor=#0F172A;arcSize=16;spacing=6;" vertex="1" parent="1"><mxGeometry x="820" y="330" width="250" height="90" as="geometry" /></mxCell>
        <mxCell id="f6" value="&lt;b&gt;6. GUARDRAIL&lt;/b&gt;&lt;br&gt;Reconcile với ledger • không phạt tài xế • bỏ qua = trung lập" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#FEE2E2;strokeColor=#DC2626;strokeWidth=1.6;fontSize=13;fontColor=#0F172A;arcSize=16;spacing=6;" vertex="1" parent="1"><mxGeometry x="500" y="330" width="250" height="90" as="geometry" /></mxCell>
        <mxCell id="f7" value="&lt;b&gt;7. Hiển thị insight&lt;/b&gt;&lt;br&gt;Card sau ca + đưa evidence vào lịch sử" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#F1F5F9;strokeColor=#64748B;strokeWidth=1.6;fontSize=13;fontColor=#0F172A;arcSize=16;spacing=6;" vertex="1" parent="1"><mxGeometry x="160" y="330" width="240" height="90" as="geometry" /></mxCell>
        <mxCell id="g1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#637381;" edge="1" parent="1" source="f1" target="f2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="g2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#637381;" edge="1" parent="1" source="f2" target="f3"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="g3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#637381;" edge="1" parent="1" source="f3" target="f4"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="g4" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#637381;" edge="1" parent="1" source="f4" target="f5"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="g5" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#637381;" edge="1" parent="1" source="f5" target="f6"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="g6" value="pass" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#637381;fontSize=11;fontColor=#475569;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="f6" target="f7"><mxGeometry relative="1" as="geometry" /></mxCell>
