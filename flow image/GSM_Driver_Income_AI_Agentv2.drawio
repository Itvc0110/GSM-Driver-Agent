        <mxCell id="x6" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#637381;" edge="1" parent="1" source="ag" target="gov"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="x7" value="allow / veto" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#637381;fontSize=11;fontColor=#475569;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="gov" target="orch"><mxGeometry relative="1" as="geometry" /></mxCell>
