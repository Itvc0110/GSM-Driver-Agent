  <diagram id="v2-F1" name="F1 — Trước ca">
    <mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="900" math="0" shadow="0" background="#FFFFFF">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="t" value="&lt;b&gt;F1 — Trước ca (khi tài xế mở app)&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=24;fontColor=#0F172A;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="24" width="1100" height="38" as="geometry" />
        </mxCell>
        <mxCell id="s" value="Chủ động nhắc chính sách/thưởng mới; đề xuất &amp;amp; nhận xét chỉ tiêu net theo hồ sơ; lộ trình đạt mốc thưởng tuần." style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=13;fontColor=#475569;" vertex="1" parent="1">
          <mxGeometry x="42" y="64" width="1320" height="26" as="geometry" />
        </mxCell>
        <mxCell id="b" value="F1" style="rounded=1;whiteSpace=wrap;html=1;align=center;fillColor=#FEF3C7;strokeColor=#D97706;fontColor=#0F172A;fontSize=11;fontStyle=1;arcSize=25;" vertex="1" parent="1">
          <mxGeometry x="1460" y="26" width="90" height="36" as="geometry" />
        </mxCell>
        <mxCell id="ln" value="" style="shape=line;strokeColor=#CBD5E1;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="40" y="102" width="1510" height="2" as="geometry" />
        </mxCell>
        <mxCell id="f1" value="&lt;b&gt;1. Mở app&lt;/b&gt;&lt;br&gt;Bắt đầu phiên trước ca" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#FEF3C7;strokeColor=#D97706;strokeWidth=1.6;fontSize=13;fontColor=#0F172A;arcSize=16;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="60" y="150" width="210" height="90" as="geometry" />
        </mxCell>
        <mxCell id="f2" value="&lt;b&gt;2. Cập nhật chủ động&lt;/b&gt;&lt;br&gt;Chính sách/thưởng mới, giới hạn mới áp cho hồ sơ này (từ Policy KB)" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#DCFCE7;strokeColor=#16A34A;strokeWidth=1.6;fontSize=13;fontColor=#0F172A;arcSize=16;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="330" y="150" width="230" height="90" as="geometry" />
        </mxCell>
        <mxCell id="f3" value="&lt;b&gt;3. Đề xuất mục tiêu payout&lt;/b&gt;&lt;br&gt;Driver payout mặc định từ policy + hồ sơ; estimated net chỉ khi đủ chi phí" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#FFEDD5;strokeColor=#EA580C;strokeWidth=1.6;fontSize=12;fontColor=#0F172A;arcSize=16;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="620" y="150" width="230" height="90" as="geometry" />
        </mxCell>
        <mxCell id="f4" value="&lt;b&gt;4. Tài xế chỉnh chỉ tiêu&lt;/b&gt;&lt;br&gt;Điều chỉnh mục tiêu/quỹ giờ" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#FEF3C7;strokeColor=#D97706;strokeWidth=1.6;fontSize=13;fontColor=#0F172A;arcSize=16;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="910" y="150" width="230" height="90" as="geometry" />
        </mxCell>
        <mxCell id="f5" value="&lt;b&gt;5. Agent nhận xét&lt;/b&gt;&lt;br&gt;Cao/thấp so hồ sơ (part-time ≠ full-time) + khuyên điều chỉnh" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#EDE9FE;strokeColor=#7C3AED;strokeWidth=1.6;fontSize=13;fontColor=#0F172A;arcSize=16;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="910" y="330" width="230" height="90" as="geometry" />
        </mxCell>
        <mxCell id="f6" value="&lt;b&gt;6. Lộ trình đạt mốc thưởng&lt;/b&gt;&lt;br&gt;Điểm/khung giờ/mốc tuần lấy từ Policy KB/config đúng profile + market + effective date" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#FFEDD5;strokeColor=#EA580C;strokeWidth=1.6;fontSize=12;fontColor=#0F172A;arcSize=16;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="600" y="330" width="250" height="90" as="geometry" />
        </mxCell>
        <mxCell id="f7" value="&lt;b&gt;7. GUARDRAIL&lt;/b&gt;&lt;br&gt;Không hứa chắc thu nhập • nêu điều kiện • không ép tăng giờ/bỏ nghỉ" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#FEE2E2;strokeColor=#DC2626;strokeWidth=1.6;fontSize=13;fontColor=#0F172A;arcSize=16;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="330" y="330" width="240" height="90" as="geometry" />
        </mxCell>
        <mxCell id="f8" value="&lt;b&gt;8. Tài xế chọn kế hoạch&lt;/b&gt;&lt;br&gt;Chốt chỉ tiêu + lộ trình cho ca" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#F1F5F9;strokeColor=#64748B;strokeWidth=1.6;fontSize=13;fontColor=#0F172A;arcSize=16;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="60" y="330" width="240" height="90" as="geometry" />
        </mxCell>
        <mxCell id="g1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#637381;" edge="1" parent="1" source="f1" target="f2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="g2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#637381;" edge="1" parent="1" source="f2" target="f3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="g3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#637381;" edge="1" parent="1" source="f3" target="f4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="g4" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#637381;" edge="1" parent="1" source="f4" target="f5">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="g5" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#637381;" edge="1" parent="1" source="f5" target="f6">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="g6" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#637381;" edge="1" parent="1" source="f6" target="f7">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="g7" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#637381;" edge="1" parent="1" source="f7" target="f8">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="gb" value="feedback: chỉnh lại" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.6;strokeColor=#2563EB;fontSize=11;fontColor=#475569;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="f5" target="f4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="v2-F2" name="F2 — Trong ca">
    <mxGraphModel dx="1212" dy="736" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="900" background="#FFFFFF" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="t" parent="1" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=24;fontColor=#0F172A;fontStyle=1;" value="&lt;b&gt;F2 — Trong ca&lt;/b&gt;" vertex="1">
          <mxGeometry height="38" width="1100" x="40" y="24" as="geometry" />
        </mxCell>
        <mxCell id="s" parent="1" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=13;fontColor=#475569;" value="Demand proxy (mock) → tư vấn thời gian chạy/nghỉ/sạc + gợi ý khu vực đứng chờ CÓ ĐIỀU KIỆN (mở 2026-07-21 sau verify: Xanh không có heatmap tài xế → bổ sung, không chồng đè). Không matching, không khuyên đơn cụ thể. Nét đứt = tương lai." vertex="1">
          <mxGeometry height="26" width="1500" x="42" y="64" as="geometry" />
        </mxCell>
        <mxCell id="b" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=center;fillColor=#DBEAFE;strokeColor=#2563EB;fontColor=#0F172A;fontSize=11;fontStyle=1;arcSize=25;" value="F2" vertex="1">
          <mxGeometry height="36" width="90" x="1460" y="26" as="geometry" />
        </mxCell>
        <mxCell id="ln" parent="1" style="shape=line;strokeColor=#CBD5E1;strokeWidth=2;" value="" vertex="1">
          <mxGeometry height="2" width="1510" x="40" y="102" as="geometry" />
        </mxCell>
        <mxCell id="f1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#DCFCE7;strokeColor=#16A34A;strokeWidth=1.6;fontSize=12;fontColor=#0F172A;arcSize=16;spacing=6;" value="&lt;b&gt;1. Mock demand proxy&lt;/b&gt;&lt;br&gt;Đơn đặt theo giờ × ngày × khu vực; KHÔNG phải pool matching/đơn chắc chắn phân cho tài xế" vertex="1">
          <mxGeometry height="90" width="240" x="60" y="150" as="geometry" />
        </mxCell>
        <mxCell id="fpin" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#F0FDF4;strokeColor=#16A34A;strokeWidth=1.4;fontSize=12;fontColor=#0F172A;arcSize=16;dashed=1;dashPattern=6 4;spacing=6;" value="&lt;b&gt;State pin xe&lt;/b&gt;&lt;br&gt;SOC • tầm hoạt động&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;◇ TƯƠNG LAI&lt;/font&gt;" vertex="1">
          <mxGeometry height="70" width="240" x="100" y="510" as="geometry" />
        </mxCell>
        <mxCell id="f2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#FFEDD5;strokeColor=#EA580C;strokeWidth=1.6;fontSize=12;fontColor=#0F172A;arcSize=16;spacing=6;" value="&lt;b&gt;2. Phân tích thời điểm&lt;/b&gt;&lt;br&gt;Khung giờ tương đối đông/vắng • sạc lệch đỉnh • gần mốc thưởng versioned" vertex="1">
          <mxGeometry height="90" width="240" x="360" y="150" as="geometry" />
        </mxCell>
        <mxCell id="f3" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#EDE9FE;strokeColor=#7C3AED;strokeWidth=1.6;fontSize=12;fontColor=#0F172A;arcSize=16;spacing=6;" value="&lt;b&gt;3. Khuyên lộ trình thời gian + khu vực (có điều kiện)&lt;/b&gt;&lt;br&gt;Khi nào chạy / nghỉ / sạc lệch đỉnh • khu vực đứng chờ: capacity-aware, cảnh báo tỷ lệ nhận, nhãn mock, không hứa thu nhập" vertex="1">
          <mxGeometry height="90" width="240" x="660" y="150" as="geometry" />
        </mxCell>
        <mxCell id="f4" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#DCFCE7;strokeColor=#16A34A;strokeWidth=1.6;fontSize=13;fontColor=#0F172A;arcSize=16;spacing=6;" value="&lt;b&gt;4. Cập nhật voucher&lt;/b&gt;&lt;br&gt;Ưu đãi mới trong ca" vertex="1">
          <mxGeometry height="90" width="220" x="960" y="150" as="geometry" />
        </mxCell>
        <mxCell id="f5" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#FEE2E2;strokeColor=#DC2626;strokeWidth=1.6;fontSize=11;fontColor=#0F172A;arcSize=16;spacing=6;" value="&lt;b&gt;5. GUARDRAIL&lt;/b&gt;&lt;br&gt;Ngưỡng từ Policy KB/config versioned • không khuyên nhận/từ chối/hủy cuốc cụ thể • advice khu vực phải qua capacity-check chống dồn cung + cảnh báo tỷ lệ nhận • không ép bỏ nghỉ • không hứa thu nhập" vertex="1">
          <mxGeometry height="90" width="320" x="860" y="330" as="geometry" />
        </mxCell>
        <mxCell id="f6" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#F1F5F9;strokeColor=#64748B;strokeWidth=1.6;fontSize=13;fontColor=#0F172A;arcSize=16;spacing=6;" value="&lt;b&gt;6. Card gợi ý&lt;/b&gt;&lt;br&gt;1 hành động chính + giải thích + expiry" vertex="1">
          <mxGeometry height="90" width="240" x="500" y="330" as="geometry" />
