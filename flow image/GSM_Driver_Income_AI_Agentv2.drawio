<mxfile host="app.diagrams.net" modified="2026-07-20T00:00:00.000Z" agent="Claude" version="26.0.9" type="device" pages="7" compressed="false">
  <diagram id="v2-L0" name="L0 — Tổng quan">
    <mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="900" math="0" shadow="0" background="#FFFFFF">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="t" value="&lt;b&gt;GSM Driver Income AI Agent — Kiến trúc v2&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=26;fontColor=#0F172A;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="22" width="1200" height="40" as="geometry" /></mxCell>
        <mxCell id="s" value="L0 · Tổng quan — từ mục tiêu tài xế đến phương án có kiểm soát. Bám scope F0–F3; &lt;b&gt;nét đứt = tính năng tương lai&lt;/b&gt;." style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=13;fontColor=#475569;" vertex="1" parent="1"><mxGeometry x="42" y="66" width="1300" height="26" as="geometry" /></mxCell>
        <mxCell id="b" value="L0" style="rounded=1;whiteSpace=wrap;html=1;align=center;fillColor=#E2E8F0;strokeColor=#64748B;fontColor=#0F172A;fontSize=11;fontStyle=1;arcSize=25;" vertex="1" parent="1"><mxGeometry x="1440" y="26" width="110" height="36" as="geometry" /></mxCell>
        <mxCell id="ln" value="" style="shape=line;strokeColor=#CBD5E1;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="40" y="104" width="1510" height="2" as="geometry" /></mxCell>
        <mxCell id="north" value="&lt;b&gt;NORTH STAR&lt;/b&gt;  Giúp tài xế đạt mục tiêu thu nhập ròng trong quỹ thời gian cố định — &lt;font color=&quot;#5F6B76&quot;&gt;không can thiệp matching, dispatch, giá hay routing&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#EAF3FA;strokeColor=#2563EB;strokeWidth=1.6;fontSize=14;fontColor=#0F172A;arcSize=16;spacing=8;" vertex="1" parent="1"><mxGeometry x="300" y="116" width="1000" height="56" as="geometry" /></mxCell>
        <mxCell id="input" value="&lt;b&gt;1. ĐẦU VÀO&lt;/b&gt;&lt;br&gt;&lt;br&gt;• Hồ sơ tài xế (track, thâm niên, tỷ lệ nhận/hoàn thành)&lt;br&gt;• Mục tiêu net + quỹ thời gian&lt;br&gt;• Thời điểm chạm: &lt;b&gt;F0 · F1 · F2 · F3&lt;/b&gt;&lt;br&gt;• Phản hồi của tài xế" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fillColor=#FEF3C7;strokeColor=#D97706;strokeWidth=1.6;fontSize=13;fontColor=#0F172A;arcSize=16;spacing=8;" vertex="1" parent="1"><mxGeometry x="45" y="210" width="235" height="250" as="geometry" /></mxCell>
        <mxCell id="bd" value="&lt;b&gt;HỆ THỐNG AI AGENT HỖ TRỢ THU NHẬP&lt;/b&gt;" style="swimlane;html=1;startSize=40;rounded=1;fillColor=#FFFFFF;strokeColor=#8AA7BD;strokeWidth=2;fontSize=15;fontStyle=1;fontColor=#16324F;arcSize=10;" vertex="1" parent="1"><mxGeometry x="330" y="200" width="930" height="370" as="geometry" /></mxCell>
        <mxCell id="flow" value="&lt;b&gt;FLOW / ORCHESTRATION&lt;/b&gt;&lt;br&gt;Thu thập → chuẩn hóa → gọi đúng thành phần → retry/fallback → audit" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#DBEAFE;strokeColor=#2563EB;strokeWidth=1.6;fontSize=13;fontColor=#0F172A;arcSize=16;spacing=6;" vertex="1" parent="bd"><mxGeometry x="30" y="52" width="245" height="98" as="geometry" /></mxCell>
        <mxCell id="rule" value="&lt;b&gt;RULE / ANALYTICS&lt;/b&gt;&lt;br&gt;Baseline • khoảng cách mục tiêu • what-if • xếp hạng • &lt;b&gt;mọi số tài chính/policy&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#FFEDD5;strokeColor=#EA580C;strokeWidth=1.6;fontSize=13;fontColor=#0F172A;arcSize=16;spacing=6;" vertex="1" parent="bd"><mxGeometry x="315" y="52" width="245" height="98" as="geometry" /></mxCell>
        <mxCell id="agent" value="&lt;b&gt;AI AGENT&lt;/b&gt;&lt;br&gt;Tổng hợp • so sánh • giải thích&lt;br&gt;&lt;font color=&quot;#6D28D9&quot;&gt;+ reasoning CÓ ĐIỀU KIỆN (log + độ tin cậy + tắt được)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#EDE9FE;strokeColor=#7C3AED;strokeWidth=1.6;fontSize=13;fontColor=#0F172A;arcSize=16;spacing=6;" vertex="1" parent="bd"><mxGeometry x="600" y="52" width="300" height="98" as="geometry" /></mxCell>
        <mxCell id="guard" value="&lt;b&gt;GUARDRAIL&lt;/b&gt;&lt;br&gt;Policy • an toàn • ngưỡng kỷ luật (≥70% nhận/hoàn thành) • ranh giới công ty&lt;br&gt;&lt;b&gt;Pass / Veto / Human review&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#FEE2E2;strokeColor=#DC2626;strokeWidth=1.6;fontSize=13;fontColor=#0F172A;arcSize=16;spacing=6;" vertex="1" parent="bd"><mxGeometry x="150" y="205" width="330" height="112" as="geometry" /></mxCell>
        <mxCell id="data" value="&lt;b&gt;DỮ LIỆU &amp;amp; TRI THỨC&lt;/b&gt;&lt;br&gt;Session state • lịch sử • Policy KB (version+citation) • Mock phân phối đơn" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#DCFCE7;strokeColor=#16A34A;strokeWidth=1.6;fontSize=13;fontColor=#0F172A;arcSize=16;spacing=6;" vertex="1" parent="bd"><mxGeometry x="520" y="205" width="380" height="112" as="geometry" /></mxCell>
        <mxCell id="output" value="&lt;b&gt;2. ĐẦU RA&lt;/b&gt;&lt;br&gt;&lt;br&gt;1–3 phương án cấp cao&lt;br&gt;• Giá trị kỳ vọng&lt;br&gt;• Độ tin cậy&lt;br&gt;• Bất định + trade-off&lt;br&gt;• Nguồn trích dẫn&lt;br&gt;&lt;br&gt;&lt;b&gt;Hoặc: Không khuyến nghị&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fillColor=#F1F5F9;strokeColor=#64748B;strokeWidth=1.6;fontSize=13;fontColor=#0F172A;arcSize=16;spacing=8;" vertex="1" parent="1"><mxGeometry x="1310" y="210" width="240" height="250" as="geometry" /></mxCell>
        <mxCell id="driver" value="&lt;b&gt;3. TÀI XẾ QUYẾT ĐỊNH&lt;/b&gt;&lt;br&gt;Chọn • điều chỉnh • bỏ qua&lt;br&gt;&lt;font color=&quot;#5F6B76&quot;&gt;Hệ thống không tự thực thi&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#FEF3C7;strokeColor=#D97706;strokeWidth=1.6;fontSize=14;fontColor=#0F172A;arcSize=16;spacing=8;" vertex="1" parent="1"><mxGeometry x="1085" y="600" width="365" height="95" as="geometry" /></mxCell>
        <mxCell id="measure" value="&lt;b&gt;4. ĐO &amp;amp; ĐÁNH GIÁ&lt;/b&gt;&lt;br&gt;So sánh kỳ vọng vs thực tế → attribution → cập nhật evidence/confidence" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#DCFCE7;strokeColor=#16A34A;strokeWidth=1.6;fontSize=13;fontColor=#0F172A;arcSize=16;spacing=8;" vertex="1" parent="1"><mxGeometry x="470" y="600" width="520" height="95" as="geometry" /></mxCell>
        <mxCell id="fcomm" value="&lt;b&gt;Nguồn cộng đồng&lt;/b&gt; (group tài xế, websearch kinh nghiệm)&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;◇ TƯƠNG LAI&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#F0FDF4;strokeColor=#16A34A;strokeWidth=1.4;fontSize=12;fontColor=#0F172A;arcSize=16;dashed=1;dashPattern=6 4;spacing=6;" vertex="1" parent="1"><mxGeometry x="45" y="490" width="235" height="56" as="geometry" /></mxCell>
        <mxCell id="ffilter" value="&lt;b&gt;KIỂM CHỨNG &amp;amp; LỌC RỦI RO&lt;/b&gt;&lt;br&gt;chống tin sai/lỗi thời/PII/nguồn giả · gắn độ tin cậy&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;◇ không dùng cho số tài chính/policy&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#FEF2F2;strokeColor=#DC2626;strokeWidth=1.6;fontSize=12;fontColor=#0F172A;arcSize=16;dashed=1;dashPattern=6 4;spacing=6;" vertex="1" parent="1"><mxGeometry x="45" y="566" width="235" height="70" as="geometry" /></mxCell>
        <mxCell id="scin" value="&lt;b&gt;TRONG SCOPE&lt;/b&gt;  F0 hỏi đáp chính sách · F1 trước ca · F2 trong ca · F3 sau ca" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fillColor=#EAF7EE;strokeColor=#16A34A;strokeWidth=1.6;fontSize=13;fontColor=#0F172A;arcSize=16;spacing=8;" vertex="1" parent="1"><mxGeometry x="45" y="720" width="710" height="52" as="geometry" /></mxCell>
        <mxCell id="scout" value="&lt;b&gt;NGOÀI SCOPE&lt;/b&gt;  matching · dispatch · pricing · routing/ETA · khuyên nhận/từ chối/hủy một cuốc cụ thể" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fillColor=#FDEEEE;strokeColor=#DC2626;strokeWidth=1.6;fontSize=13;fontColor=#0F172A;arcSize=16;dashed=1;spacing=8;" vertex="1" parent="1"><mxGeometry x="800" y="720" width="750" height="52" as="geometry" /></mxCell>
        <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#637381;fontSize=12;fontColor=#475569;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="input" target="flow"><mxGeometry relative="1" as="geometry" /><mxCell id="e1l" value="mục tiêu + bối cảnh" /></mxCell>
        <mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#637381;" edge="1" parent="1" source="flow" target="rule"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#637381;" edge="1" parent="1" source="rule" target="agent"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e4" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#637381;" edge="1" parent="1" source="agent" target="guard"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e5" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#637381;" edge="1" parent="1" source="data" target="flow"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e6" value="pass / veto" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#637381;fontSize=12;fontColor=#475569;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="guard" target="output"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e7" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#637381;" edge="1" parent="1" source="output" target="driver"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e8" value="quyết định + kết quả" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#637381;fontSize=12;fontColor=#475569;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="driver" target="measure"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e9" value="evidence" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#637381;fontSize=12;fontColor=#475569;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="measure" target="data"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="ef1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.6;strokeColor=#94A3B8;dashed=1;dashPattern=6 4;" edge="1" parent="1" source="fcomm" target="ffilter"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="ef2" value="chỉ insight (đã lọc)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.6;strokeColor=#94A3B8;dashed=1;dashPattern=6 4;fontSize=11;fontColor=#64748B;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="ffilter" target="bd"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="ft" value="v2.0 · conceptual — chưa khóa API, schema vật lý, framework (CrewAI đang đánh giá), cloud hay số lượng agent." style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=11;fontColor=#475569;" vertex="1" parent="1"><mxGeometry x="45" y="800" width="1200" height="20" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="v2-L1" name="L1 — Kiến trúc thành phần">
    <mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="900" math="0" shadow="0" background="#FFFFFF">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="t" value="&lt;b&gt;GSM Driver Income AI Agent — Kiến trúc v2&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=26;fontColor=#0F172A;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="22" width="1200" height="40" as="geometry" /></mxCell>
        <mxCell id="s" value="L1 · Kiến trúc thành phần — flow-first hybrid; AI có reasoning điều kiện; dữ liệu có nguồn gốc. Nét đứt = tương lai." style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=13;fontColor=#475569;" vertex="1" parent="1"><mxGeometry x="42" y="66" width="1300" height="26" as="geometry" /></mxCell>
        <mxCell id="b" value="L1" style="rounded=1;whiteSpace=wrap;html=1;align=center;fillColor=#E2E8F0;strokeColor=#64748B;fontColor=#0F172A;fontSize=11;fontStyle=1;arcSize=25;" vertex="1" parent="1"><mxGeometry x="1440" y="26" width="110" height="36" as="geometry" /></mxCell>
        <mxCell id="ln" value="" style="shape=line;strokeColor=#CBD5E1;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="40" y="104" width="1510" height="2" as="geometry" /></mxCell>
        <mxCell id="lane1" value="TRẢI NGHIỆM &amp;amp; QUYẾT ĐỊNH" style="swimlane;html=1;startSize=34;rounded=1;fillColor=#FFFDF7;strokeColor=#D9C67A;fontSize=13;fontStyle=1;fontColor=#0F172A;arcSize=8;" vertex="1" parent="1"><mxGeometry x="35" y="120" width="1515" height="110" as="geometry" /></mxCell>
        <mxCell id="ux" value="&lt;b&gt;UX-01 · Driver App&lt;/b&gt;&lt;br&gt;Nhập mục tiêu • xác nhận hồ sơ • xem phương án (mobile-first)" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#FEF3C7;strokeColor=#D97706;strokeWidth=1.6;fontSize=12;fontColor=#0F172A;arcSize=16;spacing=6;" vertex="1" parent="lane1"><mxGeometry x="40" y="44" width="300" height="56" as="geometry" /></mxCell>
        <mxCell id="hum" value="&lt;b&gt;HUM-01 · Tài xế quyết định&lt;/b&gt;&lt;br&gt;Chọn • điều chỉnh • bỏ qua" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#FEF3C7;strokeColor=#D97706;strokeWidth=1.6;fontSize=12;fontColor=#0F172A;arcSize=16;spacing=6;" vertex="1" parent="lane1"><mxGeometry x="1165" y="44" width="300" height="56" as="geometry" /></mxCell>
        <mxCell id="lane2" value="FLOW &amp;amp; ORCHESTRATION" style="swimlane;html=1;startSize=34;rounded=1;fillColor=#F7FBFE;strokeColor=#8EB6D1;fontSize=13;fontStyle=1;fontColor=#0F172A;arcSize=8;" vertex="1" parent="1"><mxGeometry x="35" y="242" width="1515" height="104" as="geometry" /></mxCell>
        <mxCell id="orch" value="&lt;b&gt;FLOW-01 · Controlled Orchestrator&lt;/b&gt;&lt;br&gt;State • routing • approval • retry • fallback • audit trace" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#DBEAFE;strokeColor=#2563EB;strokeWidth=1.6;fontSize=13;fontColor=#0F172A;arcSize=16;spacing=6;" vertex="1" parent="lane2"><mxGeometry x="390" y="40" width="740" height="54" as="geometry" /></mxCell>
        <mxCell id="lane3" value="NĂNG LỰC PHÂN TÍCH &amp;amp; AI" style="swimlane;html=1;startSize=34;rounded=1;fillColor=#FFFFFF;strokeColor=#B8C0C8;fontSize=13;fontStyle=1;fontColor=#0F172A;arcSize=8;" vertex="1" parent="1"><mxGeometry x="35" y="358" width="1515" height="150" as="geometry" /></mxCell>
        <mxCell id="r1" value="&lt;b&gt;RULE-01&lt;br&gt;Income Analytics&lt;/b&gt;&lt;br&gt;Baseline &amp;amp; chỉ số net" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#FFEDD5;strokeColor=#EA580C;strokeWidth=1.6;fontSize=12;fontColor=#0F172A;arcSize=16;spacing=6;" vertex="1" parent="lane3"><mxGeometry x="40" y="44" width="225" height="86" as="geometry" /></mxCell>
        <mxCell id="r2" value="&lt;b&gt;RULE-02&lt;br&gt;Goal Feasibility&lt;/b&gt;&lt;br&gt;Khoảng cách &amp;amp; what-if" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#FFEDD5;strokeColor=#EA580C;strokeWidth=1.6;fontSize=12;fontColor=#0F172A;arcSize=16;spacing=6;" vertex="1" parent="lane3"><mxGeometry x="285" y="44" width="225" height="86" as="geometry" /></mxCell>
        <mxCell id="r3" value="&lt;b&gt;RULE-03&lt;br&gt;Option Ranker&lt;/b&gt;&lt;br&gt;Giá trị • confidence • trade-off" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#FFEDD5;strokeColor=#EA580C;strokeWidth=1.6;fontSize=12;fontColor=#0F172A;arcSize=16;spacing=6;" vertex="1" parent="lane3"><mxGeometry x="530" y="44" width="225" height="86" as="geometry" /></mxCell>
        <mxCell id="ag" value="&lt;b&gt;AGENT-01&lt;br&gt;Contextual Interpreter&lt;/b&gt;&lt;br&gt;Hiểu mục tiêu mơ hồ • giải thích có căn cứ&lt;br&gt;&lt;font color=&quot;#6D28D9&quot;&gt;reasoning điều kiện (log+confidence+fallback)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#EDE9FE;strokeColor=#7C3AED;strokeWidth=1.6;fontSize=12;fontColor=#0F172A;arcSize=16;spacing=6;" vertex="1" parent="lane3"><mxGeometry x="775" y="44" width="330" height="86" as="geometry" /></mxCell>
        <mxCell id="gov" value="&lt;b&gt;GOV-01&lt;br&gt;Policy &amp;amp; Alignment Gate&lt;/b&gt;&lt;br&gt;Allow • veto • human review" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#FEE2E2;strokeColor=#DC2626;strokeWidth=1.6;fontSize=12;fontColor=#0F172A;arcSize=16;spacing=6;" vertex="1" parent="lane3"><mxGeometry x="1125" y="44" width="345" height="86" as="geometry" /></mxCell>
        <mxCell id="lane4" value="STATE · KNOWLEDGE · MOCK · UPSTREAM" style="swimlane;html=1;startSize=34;rounded=1;fillColor=#F8FCF9;strokeColor=#8DB79A;fontSize=13;fontStyle=1;fontColor=#0F172A;arcSize=8;" vertex="1" parent="1"><mxGeometry x="35" y="520" width="1515" height="260" as="geometry" /></mxCell>
        <mxCell id="d1" value="&lt;b&gt;DATA-01&lt;br&gt;Session State&lt;/b&gt;&lt;br&gt;Phiên hiện tại" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#DCFCE7;strokeColor=#16A34A;strokeWidth=1.6;fontSize=12;fontColor=#0F172A;arcSize=16;spacing=6;" vertex="1" parent="lane4"><mxGeometry x="40" y="44" width="215" height="80" as="geometry" /></mxCell>
        <mxCell id="d2" value="&lt;b&gt;DATA-02&lt;br&gt;Driver History&lt;/b&gt;&lt;br&gt;Được đồng ý + đã đánh giá" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#DCFCE7;strokeColor=#16A34A;strokeWidth=1.6;fontSize=12;fontColor=#0F172A;arcSize=16;spacing=6;" vertex="1" parent="lane4"><mxGeometry x="270" y="44" width="230" height="80" as="geometry" /></mxCell>
        <mxCell id="d3" value="&lt;b&gt;DATA-03 · Policy KB&lt;/b&gt; &lt;font color=&quot;#B45309&quot;&gt;[F0]&lt;/font&gt;&lt;br&gt;Version • effective date • citation&lt;br&gt;&lt;font color=&quot;#5F6B76&quot;&gt;research/policy&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#DCFCE7;strokeColor=#16A34A;strokeWidth=1.6;fontSize=12;fontColor=#0F172A;arcSize=16;spacing=6;" vertex="1" parent="lane4"><mxGeometry x="515" y="44" width="245" height="80" as="geometry" /></mxCell>
        <mxCell id="d4" value="&lt;b&gt;DATA-04 · Mock Order-Distribution&lt;/b&gt; &lt;font color=&quot;#B45309&quot;&gt;[F2]&lt;/font&gt;&lt;br&gt;giờ × ngày × khu vực&lt;br&gt;&lt;font color=&quot;#5F6B76&quot;&gt;specs/mock-order-distribution&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#DCFCE7;strokeColor=#16A34A;strokeWidth=1.6;fontSize=12;fontColor=#0F172A;arcSize=16;spacing=6;" vertex="1" parent="lane4"><mxGeometry x="775" y="44" width="250" height="80" as="geometry" /></mxCell>
        <mxCell id="ext" value="&lt;b&gt;EXT-01&lt;br&gt;Approved Upstream&lt;/b&gt;&lt;br&gt;Thu nhập • vận hành&lt;br&gt;&lt;font color=&quot;#5F6B76&quot;&gt;freshness-bound&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#F1F5F9;strokeColor=#64748B;strokeWidth=1.6;fontSize=12;fontColor=#0F172A;arcSize=16;dashed=1;spacing=6;" vertex="1" parent="lane4"><mxGeometry x="1040" y="44" width="200" height="80" as="geometry" /></mxCell>
        <mxCell id="hum2" value="&lt;b&gt;HUM-02&lt;br&gt;Ops / Finance / Policy&lt;/b&gt;&lt;br&gt;Ownership • approval" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#FEF3C7;strokeColor=#D97706;strokeWidth=1.6;fontSize=12;fontColor=#0F172A;arcSize=16;spacing=6;" vertex="1" parent="lane4"><mxGeometry x="1255" y="44" width="215" height="80" as="geometry" /></mxCell>
        <mxCell id="comm" value="&lt;b&gt;DATA-F1 · Community Insights&lt;/b&gt;&lt;br&gt;group tài xế • websearch kinh nghiệm&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;◇ TƯƠNG LAI&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#F0FDF4;strokeColor=#16A34A;strokeWidth=1.4;fontSize=12;fontColor=#0F172A;arcSize=16;dashed=1;dashPattern=6 4;spacing=6;" vertex="1" parent="lane4"><mxGeometry x="515" y="150" width="245" height="86" as="geometry" /></mxCell>
        <mxCell id="filt" value="&lt;b&gt;FILTER-F1 · Kiểm chứng &amp;amp; lọc rủi ro&lt;/b&gt;&lt;br&gt;nguồn official trước • chống tin sai/lỗi thời/PII&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;◇ specs/community-source-risk-control&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#FEF2F2;strokeColor=#DC2626;strokeWidth=1.6;fontSize=12;fontColor=#0F172A;arcSize=16;dashed=1;dashPattern=6 4;spacing=6;" vertex="1" parent="lane4"><mxGeometry x="775" y="150" width="250" height="86" as="geometry" /></mxCell>
        <mxCell id="note" value="&lt;b&gt;Nguyên tắc:&lt;/b&gt; AI Agent không tự tính số tài chính/policy (đến từ RULE + Policy KB). Reasoning của agent chỉ cho sub-problem chưa có cách tối ưu hóa/mô hình hóa — phải log, gắn độ tin cậy, tắt được về template. Nguồn cộng đồng phải qua FILTER, không dùng cho số tài chính/policy." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fillColor=#F4F0FB;strokeColor=#7C3AED;strokeWidth=1.4;fontSize=12;fontColor=#0F172A;arcSize=12;spacing=8;" vertex="1" parent="1"><mxGeometry x="35" y="800" width="1515" height="46" as="geometry" /></mxCell>
        <mxCell id="x1" value="mục tiêu" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#637381;fontSize=11;fontColor=#475569;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="ux" target="orch"><mxGeometry relative="1" as="geometry" /></mxCell>
