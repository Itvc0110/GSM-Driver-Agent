  <diagram id="v2-L2" name="L2 — Luồng hoạt động">
    <mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="900" math="0" shadow="0" background="#FFFFFF">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="t" value="&lt;b&gt;GSM Driver Income AI Agent — Kiến trúc v2&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=26;fontColor=#0F172A;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="22" width="1200" height="40" as="geometry" /></mxCell>
        <mxCell id="s" value="L2 · Luồng hoạt động — vòng lặp quan sát → dự báo → phương án → guardrail → giải thích → đo. Nhánh xám = kết thúc an toàn." style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=13;fontColor=#475569;" vertex="1" parent="1"><mxGeometry x="42" y="66" width="1320" height="26" as="geometry" /></mxCell>
        <mxCell id="b" value="L2" style="rounded=1;whiteSpace=wrap;html=1;align=center;fillColor=#E2E8F0;strokeColor=#64748B;fontColor=#0F172A;fontSize=11;fontStyle=1;arcSize=25;" vertex="1" parent="1"><mxGeometry x="1440" y="26" width="110" height="36" as="geometry" /></mxCell>
        <mxCell id="ln" value="" style="shape=line;strokeColor=#CBD5E1;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="40" y="104" width="1510" height="2" as="geometry" /></mxCell>
        <mxCell id="s1" value="&lt;b&gt;1. MỤC TIÊU&lt;/b&gt;&lt;br&gt;Thu nhập net + quỹ thời gian + thời điểm (F0–F3)" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#FEF3C7;strokeColor=#D97706;strokeWidth=1.6;fontSize=12;fontColor=#0F172A;arcSize=16;spacing=6;" vertex="1" parent="1"><mxGeometry x="40" y="140" width="170" height="100" as="geometry" /></mxCell>
        <mxCell id="s2" value="&lt;b&gt;2. XÁC NHẬN&lt;/b&gt;&lt;br&gt;Hồ sơ • consent • preference" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#DBEAFE;strokeColor=#2563EB;strokeWidth=1.6;fontSize=12;fontColor=#0F172A;arcSize=16;spacing=6;" vertex="1" parent="1"><mxGeometry x="245" y="140" width="170" height="100" as="geometry" /></mxCell>
        <mxCell id="s3" value="&lt;b&gt;3. THU THẬP CONTEXT&lt;/b&gt;&lt;br&gt;State + Policy KB + Mock đơn + provenance" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#DBEAFE;strokeColor=#2563EB;strokeWidth=1.6;fontSize=12;fontColor=#0F172A;arcSize=16;spacing=6;" vertex="1" parent="1"><mxGeometry x="450" y="140" width="170" height="100" as="geometry" /></mxCell>
        <mxCell id="s4" value="&lt;b&gt;4. KIỂM TRA DỮ LIỆU&lt;/b&gt;&lt;br&gt;Đủ • mới • tin cậy?" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#FFEDD5;strokeColor=#EA580C;strokeWidth=1.6;fontSize=12;fontColor=#0F172A;arcSize=16;spacing=6;" vertex="1" parent="1"><mxGeometry x="655" y="140" width="170" height="100" as="geometry" /></mxCell>
        <mxCell id="s5" value="&lt;b&gt;5. BASELINE &amp;amp; GAP&lt;/b&gt;&lt;br&gt;Net hiện tại vs mục tiêu" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#FFEDD5;strokeColor=#EA580C;strokeWidth=1.6;fontSize=12;fontColor=#0F172A;arcSize=16;spacing=6;" vertex="1" parent="1"><mxGeometry x="860" y="140" width="170" height="100" as="geometry" /></mxCell>
        <mxCell id="s6" value="&lt;b&gt;6. CƠ HỘI KIỂM SOÁT&lt;/b&gt;&lt;br&gt;Khung giờ • nghỉ/sạc • mốc thưởng" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#FFEDD5;strokeColor=#EA580C;strokeWidth=1.6;fontSize=12;fontColor=#0F172A;arcSize=16;spacing=6;" vertex="1" parent="1"><mxGeometry x="1065" y="140" width="170" height="100" as="geometry" /></mxCell>
        <mxCell id="s7" value="&lt;b&gt;7. TẠO PHƯƠNG ÁN&lt;/b&gt;&lt;br&gt;What-if + trade-off" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#FFEDD5;strokeColor=#EA580C;strokeWidth=1.6;fontSize=12;fontColor=#0F172A;arcSize=16;spacing=6;" vertex="1" parent="1"><mxGeometry x="1270" y="140" width="170" height="100" as="geometry" /></mxCell>
        <mxCell id="s8" value="&lt;b&gt;8. XẾP HẠNG&lt;/b&gt;&lt;br&gt;Giá trị • confidence • trade-off" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#FFEDD5;strokeColor=#EA580C;strokeWidth=1.6;fontSize=12;fontColor=#0F172A;arcSize=16;spacing=6;" vertex="1" parent="1"><mxGeometry x="1270" y="360" width="170" height="100" as="geometry" /></mxCell>
        <mxCell id="s9" value="&lt;b&gt;9. GUARDRAIL&lt;/b&gt;&lt;br&gt;Pass • veto • human review&lt;br&gt;ngưỡng kỷ luật ≥70%" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#FEE2E2;strokeColor=#DC2626;strokeWidth=1.6;fontSize=12;fontColor=#0F172A;arcSize=16;spacing=6;" vertex="1" parent="1"><mxGeometry x="1050" y="360" width="185" height="100" as="geometry" /></mxCell>
        <mxCell id="s10" value="&lt;b&gt;10. AI GIẢI THÍCH&lt;/b&gt;&lt;br&gt;Ngắn • có căn cứ • nêu bất định&lt;br&gt;&lt;font color=&quot;#6D28D9&quot;&gt;reasoning điều kiện (log)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#EDE9FE;strokeColor=#7C3AED;strokeWidth=1.6;fontSize=12;fontColor=#0F172A;arcSize=16;spacing=6;" vertex="1" parent="1"><mxGeometry x="820" y="360" width="185" height="100" as="geometry" /></mxCell>
        <mxCell id="s11" value="&lt;b&gt;11. TÀI XẾ QUYẾT ĐỊNH&lt;/b&gt;&lt;br&gt;Chọn • điều chỉnh • bỏ qua" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#FEF3C7;strokeColor=#D97706;strokeWidth=1.6;fontSize=12;fontColor=#0F172A;arcSize=16;spacing=6;" vertex="1" parent="1"><mxGeometry x="590" y="360" width="185" height="100" as="geometry" /></mxCell>
        <mxCell id="s12" value="&lt;b&gt;12. ĐO KẾT QUẢ&lt;/b&gt;&lt;br&gt;Kỳ vọng vs thực tế" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#DCFCE7;strokeColor=#16A34A;strokeWidth=1.6;fontSize=12;fontColor=#0F172A;arcSize=16;spacing=6;" vertex="1" parent="1"><mxGeometry x="360" y="360" width="185" height="100" as="geometry" /></mxCell>
        <mxCell id="s13" value="&lt;b&gt;13. CẬP NHẬT EVIDENCE&lt;/b&gt;&lt;br&gt;Sau attribution + governance" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#DCFCE7;strokeColor=#16A34A;strokeWidth=1.6;fontSize=12;fontColor=#0F172A;arcSize=16;spacing=6;" vertex="1" parent="1"><mxGeometry x="90" y="360" width="185" height="100" as="geometry" /></mxCell>
        <mxCell id="c1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#637381;" edge="1" parent="1" source="s1" target="s2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="c2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#637381;" edge="1" parent="1" source="s2" target="s3"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="c3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#637381;" edge="1" parent="1" source="s3" target="s4"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="c4" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#637381;" edge="1" parent="1" source="s4" target="s5"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="c5" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#637381;" edge="1" parent="1" source="s5" target="s6"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="c6" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#637381;" edge="1" parent="1" source="s6" target="s7"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="c7" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#637381;" edge="1" parent="1" source="s7" target="s8"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="c8" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#637381;" edge="1" parent="1" source="s8" target="s9"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="c9" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#637381;" edge="1" parent="1" source="s9" target="s10"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="c10" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#637381;" edge="1" parent="1" source="s10" target="s11"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="c11" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#637381;" edge="1" parent="1" source="s11" target="s12"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="c12" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#637381;" edge="1" parent="1" source="s12" target="s13"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="c13" value="evidence cho lần sau" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#637381;fontSize=11;fontColor=#475569;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="s13" target="s3"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="182" y="560" /><mxPoint x="535" y="560" /></Array></mxGeometry></mxCell>
        <mxCell id="b1" value="&lt;b&gt;THIẾU DỮ LIỆU&lt;/b&gt;&lt;br&gt;Không đoán → hỏi thêm / no-rec" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#F1F5F9;strokeColor=#64748B;strokeWidth=1.4;fontSize=11;fontColor=#0F172A;arcSize=16;dashed=1;spacing=6;" vertex="1" parent="1"><mxGeometry x="650" y="610" width="200" height="70" as="geometry" /></mxCell>
        <mxCell id="b2" value="&lt;b&gt;KHÔNG CƠ HỘI KIỂM SOÁT&lt;/b&gt;&lt;br&gt;Hiển thị baseline, không khuyến nghị" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#F1F5F9;strokeColor=#64748B;strokeWidth=1.4;fontSize=11;fontColor=#0F172A;arcSize=16;dashed=1;spacing=6;" vertex="1" parent="1"><mxGeometry x="1060" y="610" width="200" height="70" as="geometry" /></mxCell>
        <mxCell id="b3" value="&lt;b&gt;VETO / LOW CONFIDENCE&lt;/b&gt;&lt;br&gt;Veto hoặc human review; nêu rõ bất định" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#FEE2E2;strokeColor=#DC2626;strokeWidth=1.4;fontSize=11;fontColor=#0F172A;arcSize=16;dashed=1;spacing=6;" vertex="1" parent="1"><mxGeometry x="1035" y="500" width="200" height="66" as="geometry" /></mxCell>
        <mxCell id="be1" value="không" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.6;strokeColor=#8995A1;dashed=1;fontSize=11;fontColor=#5F6B76;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="s4" target="b1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="be2" value="không" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.6;strokeColor=#8995A1;dashed=1;fontSize=11;fontColor=#5F6B76;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="s6" target="b2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="be3" value="veto" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.6;strokeColor=#8995A1;dashed=1;fontSize=11;fontColor=#5F6B76;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="s9" target="b3"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="pr" value="&lt;b&gt;Kết thúc an toàn:&lt;/b&gt; thiếu dữ liệu → không đoán | không cơ hội → không khuyến nghị | tài xế bỏ qua → ghi nhận trung lập, không phạt | chênh lệch lớn → đưa vào evaluation backlog." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fillColor=#F7F8FA;strokeColor=#A7B0BA;strokeWidth=1.4;fontSize=12;fontColor=#0F172A;arcSize=12;spacing=8;" vertex="1" parent="1"><mxGeometry x="90" y="720" width="1350" height="50" as="geometry" /></mxCell>
      </root>
