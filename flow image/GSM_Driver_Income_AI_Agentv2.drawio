        <mxCell id="f7" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#FEF3C7;strokeColor=#D97706;strokeWidth=1.6;fontSize=13;fontColor=#0F172A;arcSize=16;spacing=6;" value="&lt;b&gt;7. Tài xế quyết định&lt;/b&gt;&lt;br&gt;Làm theo / bỏ qua" vertex="1">
          <mxGeometry height="90" width="220" x="160" y="330" as="geometry" />
