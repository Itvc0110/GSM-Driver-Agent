  <diagram id="v2-F3" name="F3 — Sau ca">
    <mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="900" math="0" shadow="0" background="#FFFFFF">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="t" value="&lt;b&gt;F3 — Sau ca (analyzer + advisor)&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=24;fontColor=#0F172A;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="24" width="1100" height="38" as="geometry" />
        </mxCell>
        <mxCell id="s" value="Tổng hợp hành vi trong ca → phát hiện điểm chưa tối ưu → 1 bài học cụ thể cho ca tới. Reconcile với ledger, không phạt tài xế." style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=13;fontColor=#475569;" vertex="1" parent="1">
          <mxGeometry x="42" y="64" width="1340" height="26" as="geometry" />
        </mxCell>
        <mxCell id="b" value="F3" style="rounded=1;whiteSpace=wrap;html=1;align=center;fillColor=#DCFCE7;strokeColor=#16A34A;fontColor=#0F172A;fontSize=11;fontStyle=1;arcSize=25;" vertex="1" parent="1">
          <mxGeometry x="1460" y="26" width="90" height="36" as="geometry" />
        </mxCell>
        <mxCell id="ln" value="" style="shape=line;strokeColor=#CBD5E1;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="40" y="102" width="1510" height="2" as="geometry" />
        </mxCell>
        <mxCell id="f1" value="&lt;b&gt;1. Tổng hợp ca&lt;/b&gt;&lt;br&gt;Ledger + thời gian + cuốc + sạc + tỷ lệ nhận/hoàn thành" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#DCFCE7;strokeColor=#16A34A;strokeWidth=1.6;fontSize=13;fontColor=#0F172A;arcSize=16;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="60" y="150" width="240" height="90" as="geometry" />
        </mxCell>
        <mxCell id="f2" value="&lt;b&gt;2. Analyzer&lt;/b&gt;&lt;br&gt;So kế hoạch + comparable self-days (rule/analytics)" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#FFEDD5;strokeColor=#EA580C;strokeWidth=1.6;fontSize=13;fontColor=#0F172A;arcSize=16;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="360" y="150" width="240" height="90" as="geometry" />
        </mxCell>
        <mxCell id="f3" value="&lt;b&gt;3. Phát hiện chưa tối ưu&lt;/b&gt;&lt;br&gt;Sạc giờ cao điểm • thiếu điểm tới mốc versioned • tỷ lệ nhận gần ngưỡng policy • pattern bỏ lỡ cơ hội (không phán xét từng cuốc)" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#FFEDD5;strokeColor=#EA580C;strokeWidth=1.6;fontSize=11;fontColor=#0F172A;arcSize=16;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="660" y="150" width="250" height="90" as="geometry" />
        </mxCell>
        <mxCell id="f4" value="&lt;b&gt;4. Chọn 1–3 driver of outcome&lt;/b&gt;&lt;br&gt;Yếu tố ảnh hưởng lớn nhất" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#FFEDD5;strokeColor=#EA580C;strokeWidth=1.6;fontSize=13;fontColor=#0F172A;arcSize=16;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="970" y="150" width="230" height="90" as="geometry" />
        </mxCell>
        <mxCell id="f5" value="&lt;b&gt;5. AI giải thích + 1 bài học&lt;/b&gt;&lt;br&gt;Explicit, dễ hiểu • 1 thay đổi cho ca tới&lt;br&gt;&lt;font color=&quot;#6D28D9&quot;&gt;reasoning điều kiện (log)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#EDE9FE;strokeColor=#7C3AED;strokeWidth=1.6;fontSize=13;fontColor=#0F172A;arcSize=16;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="820" y="330" width="250" height="90" as="geometry" />
        </mxCell>
        <mxCell id="f6" value="&lt;b&gt;6. GUARDRAIL&lt;/b&gt;&lt;br&gt;Reconcile với ledger • không phạt tài xế • bỏ qua = trung lập" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#FEE2E2;strokeColor=#DC2626;strokeWidth=1.6;fontSize=13;fontColor=#0F172A;arcSize=16;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="500" y="330" width="250" height="90" as="geometry" />
        </mxCell>
        <mxCell id="f7" value="&lt;b&gt;7. Hiển thị insight&lt;/b&gt;&lt;br&gt;Card sau ca + đưa evidence vào lịch sử" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#F1F5F9;strokeColor=#64748B;strokeWidth=1.6;fontSize=13;fontColor=#0F172A;arcSize=16;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="160" y="330" width="240" height="90" as="geometry" />
        </mxCell>
        <mxCell id="g1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#637381;" edge="1" parent="1" source="f1" target="f2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="g2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#637381;" edge="1" parent="1" source="f2" target="f3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="g3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#637381;" edge="1" parent="1" source="f3" target="f4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="g4" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#637381;" edge="1" parent="1" source="f4" target="f5">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="g5" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#637381;" edge="1" parent="1" source="f5" target="f6">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="g6" value="pass" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#637381;fontSize=11;fontColor=#475569;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="f6" target="f7">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="v2-SIM" name="SIM — Twin-world 3 arm">
    <mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="900" math="0" shadow="0" background="#FFFFFF">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="t" value="&lt;b&gt;SIM — Giả lập Twin-World 3 arm (đánh giá hiệu quả advisor)&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=24;fontColor=#0F172A;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="24" width="1200" height="38" as="geometry" />
        </mxCell>
        <mxCell id="s" value="Pilot: Đống Đa, H3 res 9 (85 cells), 50 actors từ 5 archetype, 1.200 đơn/ngày, 11 tủ pin thật (OSM). CRN cùng seed, exogenous trace dùng chung. APPROVED 2026-07-21. Specs: simulation-pilot-world, sim-policy-bundle-v0, advisor-optimization-layer-a." style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=12;fontColor=#475569;" vertex="1" parent="1">
          <mxGeometry x="42" y="64" width="1500" height="26" as="geometry" />
        </mxCell>
        <mxCell id="b" value="SIM" style="rounded=1;whiteSpace=wrap;html=1;align=center;fillColor=#E2E8F0;strokeColor=#64748B;fontColor=#0F172A;fontSize=11;fontStyle=1;arcSize=25;" vertex="1" parent="1">
          <mxGeometry x="1460" y="26" width="90" height="36" as="geometry" />
        </mxCell>
        <mxCell id="ln" value="" style="shape=line;strokeColor=#CBD5E1;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="40" y="102" width="1510" height="2" as="geometry" />
        </mxCell>
        <mxCell id="shared" value="&lt;b&gt;SHARED (cùng seed — Common Random Numbers)&lt;/b&gt;&lt;br&gt;Exogenous trace: demand (giờ×cell), OD, thời tiết • Dispatcher batched-Hungarian (hộp đen chung) • Policy bundle sim-v0 (MOCK) • 50 actors (P1–P5 archetype + jitter) • RNG per (entity, purpose)" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#DCFCE7;strokeColor=#16A34A;strokeWidth=1.6;fontSize=12;fontColor=#0F172A;arcSize=16;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="300" y="130" width="1000" height="90" as="geometry" />
        </mxCell>
        <mxCell id="armA" value="&lt;b&gt;ARM A — Advisor thông minh&lt;/b&gt;&lt;br&gt;Trigger hybrid + DP lớp A (bucket 30ph)&lt;br&gt;Capacity ledger + staggering (chống herding)&lt;br&gt;Config: advice_scope (product_only/sim_extended) × information (product_proxy/oracle)" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#EDE9FE;strokeColor=#7C3AED;strokeWidth=1.6;fontSize=12;fontColor=#0F172A;arcSize=16;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="90" y="290" width="400" height="110" as="geometry" />
        </mxCell>
        <mxCell id="armB" value="&lt;b&gt;ARM B — Baseline&lt;/b&gt;&lt;br&gt;Không advice; behavior model bản năng&lt;br&gt;(utility + kinh nghiệm cá nhân theo archetype)&lt;br&gt;Calibration gate T-021 trước khi so sánh" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#FEF3C7;strokeColor=#D97706;strokeWidth=1.6;fontSize=12;fontColor=#0F172A;arcSize=16;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="600" y="290" width="400" height="110" as="geometry" />
        </mxCell>
        <mxCell id="armC" value="&lt;b&gt;ARM C — Placebo&lt;/b&gt;&lt;br&gt;Cùng trigger engine + cooldown/budget như A&lt;br&gt;Content random-safe (không dùng intelligence)&lt;br&gt;Δ(C−B) có thể âm — báo hai chiều" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#F1F5F9;strokeColor=#64748B;strokeWidth=1.6;fontSize=12;fontColor=#0F172A;arcSize=16;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="1110" y="290" width="400" height="110" as="geometry" />
        </mxCell>
        <mxCell id="layers" value="&lt;b&gt;PHÂN LỚP BIẾN (robust optimization)&lt;/b&gt;&lt;br&gt;&lt;b&gt;A bền vững&lt;/b&gt; → bài toán tối ưu ràng buộc (SOC, quỹ giờ, payout, điểm, demand proxy)&lt;br&gt;&lt;b&gt;B bán bền vững&lt;/b&gt; → feature flag available_this_session (thời tiết, supply field, pin tủ)&lt;br&gt;&lt;b&gt;C bất định&lt;/b&gt; → agent reasoning + guardrail (log, confidence, fallback)" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fillColor=#FFEDD5;strokeColor=#EA580C;strokeWidth=1.6;fontSize=12;fontColor=#0F172A;arcSize=16;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="90" y="460" width="640" height="120" as="geometry" />
        </mxCell>
        <mxCell id="eval" value="&lt;b&gt;EVALUATOR (paired theo seed, 20–30 seeds)&lt;/b&gt;&lt;br&gt;Δ(A−B) • Δ(C−B) • &lt;b&gt;Δ(A−C) = giá trị intelligence&lt;/b&gt;&lt;br&gt;Metrics 3 tầng: driver payout/h • system (service, queue trạm, herding) • fairness (per archetype)&lt;br&gt;Adherence twin-diff: Explicit/Coincident/Partial/Ignore/Unseen + divergence index + proximal 90ph&lt;br&gt;Sweep: adherence {0/default/100%} × scope × information" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fillColor=#DBEAFE;strokeColor=#2563EB;strokeWidth=1.6;fontSize=12;fontColor=#0F172A;arcSize=16;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="800" y="460" width="710" height="120" as="geometry" />
        </mxCell>
        <mxCell id="viz" value="&lt;b&gt;VIZ &amp;amp; OUTPUT&lt;/b&gt;&lt;br&gt;Event log parquet + manifest (seed, config, policy_bundle_version, nhãn MOCK) • kepler.gl replay (H3 + trip + queue trạm) • Streamlit dashboard (Δ + CI, boxplot archetype, funnel adherence)" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#F1F5F9;strokeColor=#64748B;strokeWidth=1.6;fontSize=12;fontColor=#0F172A;arcSize=16;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="300" y="640" width="1000" height="80" as="geometry" />
        </mxCell>
        <mxCell id="note" value="&lt;b&gt;Ranh giới:&lt;/b&gt; fleet-awareness (capacity ledger, station steering) chỉ trong SIM để nghiên cứu (D-004 nới cho sim); advice_scope=product_only là headline cho quyết định sản phẩm. Mọi số sim = MOCK, không phải số GSM." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fillColor=#FDEEEE;strokeColor=#DC2626;strokeWidth=1.6;fontSize=12;fontColor=#0F172A;arcSize=16;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="300" y="760" width="1000" height="70" as="geometry" />
        </mxCell>
        <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#637381;" edge="1" parent="1" source="shared" target="armA">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#637381;" edge="1" parent="1" source="shared" target="armB">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#637381;" edge="1" parent="1" source="shared" target="armC">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e4" value="lớp A+B feed optimization; lớp C reasoning" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.6;strokeColor=#94A3B8;fontSize=11;fontColor=#64748B;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="layers" target="armA">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e5" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#637381;" edge="1" parent="1" source="armA" target="eval">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e6" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#637381;" edge="1" parent="1" source="armB" target="eval">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e7" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#637381;" edge="1" parent="1" source="armC" target="eval">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e8" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#637381;" edge="1" parent="1" source="eval" target="viz">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
