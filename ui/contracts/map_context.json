{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "MapContextContract",
  "type": "object",
  "properties": {
    "scenario_id": { "type": "string" },
    "seed": { "type": "integer" },
    "data_mode": { "type": "string", "enum": ["synthetic"] },
    "timestamp": { "type": "string" },
    "driver_location": {
      "type": "object",
      "properties": {
        "lat": { "type": "number" },
        "lng": { "type": "number" },
        "heading": { "type": "number" },
        "speed_kmh": { "type": "number" }
      },
      "required": ["lat", "lng"]
    },
    "demand_zones": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "h3_index": { "type": "string" },
          "lat": { "type": "number" },
          "lng": { "type": "number" },
          "intensity": { "type": "number" },
          "freshness_sec": { "type": "integer" }
        },
        "required": ["h3_index", "lat", "lng", "intensity"]
      }
    },
    "charging_stations": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "lat": { "type": "number" },
          "lng": { "type": "number" },
          "available_ports": { "type": "integer" },
          "total_ports": { "type": "integer" },
          "distance_km": { "type": "number" }
        },
        "required": ["id", "name", "lat", "lng"]
      }
    },
    "alerts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "type": { "type": "string", "enum": ["soc_warning", "weather_rain", "high_demand"] },
          "title": { "type": "string" },
          "message": { "type": "string" },
          "severity": { "type": "string", "enum": ["info", "warning", "critical"] }
        },
        "required": ["id", "type", "title", "message"]
      }
    }
  },
  "required": ["scenario_id", "seed", "data_mode", "timestamp", "driver_location", "demand_zones", "charging_stations", "alerts"]
}
