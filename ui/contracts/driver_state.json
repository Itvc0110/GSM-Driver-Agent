{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "DriverStateContract",
  "description": "v1.1 (2026-07-26, additive — mọi field mới OPTIONAL để Flutter v0 của Khánh vẫn parse được). Money tách lớp theo CLAUDE §5: gross / payout (mặc định) / est_net chỉ khi đủ known costs.",
  "type": "object",
  "properties": {
    "driver_id": {
      "type": "string"
    },
    "driver_name": {
      "type": "string"
    },
    "shift_status": {
      "type": "string",
      "enum": [
        "ON_SHIFT",
        "OFF_SHIFT",
        "BREAK"
      ]
    },
    "soc_percent": {
      "type": "integer"
    },
    "vehicle_range_km": {
      "type": "number",
      "description": "Tầm pin còn lại (km) — số THẬN TRỌNG suy từ `vehicle.*_consume_pct_per_km` của engine (D-M3-17: bản cũ dùng hệ số riêng `soc*1.1`, lệch 1,76x). Bảng dữ liệu không cho biết đội pin nên đây là đầu THẤP của dải. Giữ kiểu `number` (không null) vì Flutter ép `as num`."
    },
    "money": {
      "type": "object",
      "description": "MỚI v1.1 — tách lớp tiền; UI hiển thị payout mặc định, gross phải ghi rõ nhãn",
      "properties": {
        "gross_vnd": {
          "type": "integer"
        },
        "payout_vnd": {
          "type": "integer"
        },
        "payout_breakdown": {
          "type": "object",
          "properties": {
            "trip_payout_vnd": {
              "type": "integer"
            },
            "day_bonus_vnd": {
              "type": "integer"
            },
            "mission_reward_vnd": {
              "type": "integer"
            },
            "newbie_vnd": {
              "type": "integer"
            }
          }
        },
        "est_net_vnd": {
          "type": [
            "integer",
            "null"
          ],
          "description": "null khi chưa đủ known costs + definition version"
        },
        "definition_version": {
          "type": "string"
        }
      },
      "required": [
        "gross_vnd",
        "payout_vnd"
      ]
    },
    "tenure_days": {
      "type": "integer",
      "description": "MỚI v1.1"
    },
    "rating": {
      "type": "object",
      "description": "MỚI v1.1 — từ counter sim (event trip_rated), không phải gauss",
      "properties": {
        "n": {
          "type": "integer"
        },
        "avg": {
          "type": [
            "number",
            "null"
          ]
        },
        "five_rate": {
          "type": [
            "number",
            "null"
          ]
        }
      }
    },
    "missions": {
      "type": "array",
      "description": "MỚI v1.1 — tiến độ mission từ sim/mock",
      "items": {
        "type": "object",
        "properties": {
          "mission_id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "progress": {
            "type": "integer"
          },
          "target": {
            "type": "integer"
          },
          "reward_vnd": {
            "type": "integer"
          },
          "done": {
            "type": "boolean"
          }
        },
        "required": [
          "mission_id",
          "progress",
          "target"
        ]
      }
    },
    "payout_summary": {
      "type": "object",
      "properties": {
        "value": {
          "type": "number"
        },
        "currency": {
          "type": "string"
        },
        "trips_count": {
          "type": "integer"
        },
        "scenario_id": {
          "type": "string"
        },
        "seed": {
          "type": "integer"
        },
        "data_mode": {
          "type": "string",
          "enum": [
            "synthetic",
            "mock-realdata"
          ]
        },
        "is_mock": {
          "type": "boolean"
        }
      },
      "required": [
        "value",
        "currency",
        "trips_count",
        "scenario_id",
        "seed",
        "data_mode",
        "is_mock"
      ]
    },
    "soc_source": {
      "type": "string",
      "enum": [
        "MOCK",
        "THẬT"
      ],
      "description": "Nguồn của soc_percent. 13 bảng GSM không có telemetry pin ⇒ hiện luôn MOCK; UI BẮT BUỘC hiển thị nhãn này cạnh chỉ báo pin (Q-06)."
    },
    "vehicle_range_km_source": {
      "type": "string",
      "enum": [
        "MOCK",
        "THẬT"
      ],
      "description": "Nguồn của vehicle_range_km — suy từ soc_percent nên cùng nhãn."
    },
    "vehicle_range_km_low": {
      "type": "number",
      "description": "Đầu thấp của dải tầm pin (đội đổi pin)."
    },
    "vehicle_range_km_high": {
      "type": "number",
      "description": "Đầu cao của dải tầm pin (đội sạc)."
    },
    "vehicle_range_km_applicable": {
      "type": "boolean",
      "description": "D-M3-18: `false` khi hệ số KHÔNG áp dụng được cho đội của tài xế — engine chỉ mô hình XE MÁY điện, nhưng catalog có 40/150 tài xế xe hơi. UI PHẢI ẩn con số khi cờ này false (xem `ui/web/js/app.js` renderEv)."
    },
    "vehicle_range_km_basis": {
      "type": "string",
      "description": "Cơ sở của con số — nói rõ là THẬN TRỌNG hay KHÔNG CÓ CƠ SỞ, kèm hệ số dùng."
    }
  },
  "required": [
    "driver_id",
    "driver_name",
    "shift_status",
    "soc_percent",
    "vehicle_range_km",
    "payout_summary",
    "soc_source",
    "vehicle_range_km_source",
    "vehicle_range_km_applicable",
    "vehicle_range_km_basis"
  ]
}
